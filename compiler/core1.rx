// =========================================================================
//            STAGE-1 SELF-HOSTED SOVEREIGN COMPILER (core1.rx)
//              Governed by Eternal Interface Architecture (EIA)
// =========================================================================

// -------------------------------------------------------------------------
//                         1. EIA Core Structures
// -------------------------------------------------------------------------

struct UniversalHologramHeader {
    magic: u32,
    version: u32,
    abi_epoch: u64,
    contracts_offset: u64,
    contracts_count: u64,
    relocs_offset: u64,
    relocs_count: u64,
    type_graph_offset: u64,
    type_graph_size: u64,
    blake3_root: u64,
    flags: u64,
    reserved0: u64,
    reserved1: u64,
}

struct SymbolContract {
    symbol_hash: u64,
    type_sig_hash: u64,
    vaddr: u64,
    code_size: u64,
    flags: u32,
    param_conv: u32,
    contract_digest: u64,
}

struct EiaRelocHole {
    insn_offset: u32,
    patch_kind: u32,
    type_sig_hash: u64,
    field_or_sym_hash: u64,
}

struct EiaTypeGraphEntry {
    type_sig_hash: u64,
    field_hash: u64,
    byte_offset: u32,
    field_size: u32,
}

// -------------------------------------------------------------------------
//                         2. Memory & Arena Allocator
// -------------------------------------------------------------------------

struct Arena {
    memory: *mut u8,
    offset: u64,
    capacity: u64,
}

fn mmap_alloc(size: u64) -> *mut u8 {
    // SYS_mmap = 9: addr=0, len=size, prot=PROT_READ|PROT_WRITE (3), flags=MAP_PRIVATE|MAP_ANONYMOUS (34), fd=-1, off=0
    let ptr: *mut u8 = syscall(9, 0, size, 3, 34, -1, 0) as *mut u8;
    if (ptr as i64) <= 0 {
        return 0 as *mut u8;
    }
    return ptr;
}

fn arena_init(arena: *mut Arena, size: u64) {
    let mem: *mut u8 = mmap_alloc(size);
    arena.memory = mem;
    arena.offset = 0;
    arena.capacity = size;
}

fn arena_alloc(arena: *mut Arena, bytes: u64) -> *mut u8 {
    let aligned: u64 = ((bytes + 7) / 8) * 8;
    let cur: u64 = arena.offset;
    let next_off: u64 = cur + aligned;
    arena.offset = next_off;
    let ptr: *mut u8 = arena.memory + cur;
    return ptr;
}

// -------------------------------------------------------------------------
//                         3. Hasher & String Helpers
// -------------------------------------------------------------------------

fn hash_identifier(start: *u8, len: u32) -> u64 {
    let mut h: u64 = 14695981039346656037;
    let mut i: u32 = 0;
    while i < len {
        let b: u8 = start[i as u64];
        h = h ^ (b as u64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn is_digit(c: u8) -> u32 {
    if c >= 48 && c <= 57 { return 1; }
    return 0;
}

fn is_alpha(c: u8) -> u32 {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { return 1; }
    return 0;
}

fn is_alnum(c: u8) -> u32 {
    if is_alpha(c) == 1 || is_digit(c) == 1 { return 1; }
    return 0;
}

fn classify_keyword(h: u64) -> u32 {
    if h == 14058172984575203104 { return 10; } // struct
    if h == 619343937915704565   { return 11; } // fn
    if h == 1329270083436697466  { return 12; } // let
    if h == 569227173069198361   { return 13; } // mut
    if h == 628023482707099174   { return 14; } // if
    if h == 9163537027783908656  { return 15; } // else
    if h == 14882043299657492846 { return 16; } // while
    if h == 14251563519059995999 { return 17; } // return
    if h == 6740575782527371194  { return 18; } // syscall
    if h == 620464340264662349   { return 19; } // as
    if h == 3089943341986682694  { return 20; } // i64
    if h == 5563585020063213298  { return 21; } // u64
    if h == 5560783464435099345  { return 22; } // u32
    if h == 631772817358541784   { return 23; } // u8
    if h == 3563412735833858527  { return 24; } // void
    if h == 417800907370030071   { return 25; } // extern
    return 1; // TOK_IDENT
}

// -------------------------------------------------------------------------
//                         4. Self-Hosted Lexer
// -------------------------------------------------------------------------

struct Token {
    kind: u32,
    start: *u8,
    len: u32,
    int_val: u64,
    hash: u64,
}

struct Lexer {
    src: *u8,
    len: u64,
    pos: u64,
    line: u32,
    col: u32,
}

fn skip_whitespace(lex: *mut Lexer) {
    let mut loop_flag: u32 = 1;
    while loop_flag == 1 {
        if lex.pos >= lex.len {
            loop_flag = 0;
        } else {
            let c: u8 = lex.src[lex.pos];
            if c == 32 || c == 9 || c == 10 || c == 13 {
                if c == 10 {
                    lex.line = lex.line + 1;
                    lex.col = 1;
                } else {
                    lex.col = lex.col + 1;
                }
                lex.pos = lex.pos + 1;
            } else if c == 47 {
                let next_pos: u64 = lex.pos + 1;
                if next_pos < lex.len && lex.src[next_pos] == 47 {
                    lex.pos = lex.pos + 2;
                    while lex.pos < lex.len && lex.src[lex.pos] != 10 {
                        lex.pos = lex.pos + 1;
                    }
                } else {
                    loop_flag = 0;
                }
            } else {
                loop_flag = 0;
            }
        }
    }
}

fn lex_next_token(lex: *mut Lexer, tok: *mut Token) {
    skip_whitespace(lex);

    if lex.pos >= lex.len {
        tok.kind = 0; // EOF
        tok.start = lex.src + lex.pos;
        tok.len = 0;
        tok.int_val = 0;
        tok.hash = 0;
        return;
    }

    let start_pos: u64 = lex.pos;
    let start_ptr: *u8 = lex.src + start_pos;
    let c: u8 = lex.src[start_pos];
    lex.pos = lex.pos + 1;
    lex.col = lex.col + 1;

    // 1. Identifiers & Keywords
    if is_alpha(c) == 1 {
        while lex.pos < lex.len && is_alnum(lex.src[lex.pos]) == 1 {
            lex.pos = lex.pos + 1;
            lex.col = lex.col + 1;
        }
        let tok_len: u32 = (lex.pos - start_pos) as u32;
        let h: u64 = hash_identifier(start_ptr, tok_len);
        let k: u32 = classify_keyword(h);

        tok.kind = k;
        tok.start = start_ptr;
        tok.len = tok_len;
        tok.int_val = 0;
        tok.hash = h;
        return;
    }

    // 2. Integer Literals
    if is_digit(c) == 1 {
        let mut val: u64 = (c - 48) as u64;
        while lex.pos < lex.len && is_digit(lex.src[lex.pos]) == 1 {
            let d: u8 = lex.src[lex.pos];
            val = val * 10 + ((d - 48) as u64);
            lex.pos = lex.pos + 1;
            lex.col = lex.col + 1;
        }
        tok.kind = 2; // TOK_INT
        tok.start = start_ptr;
        tok.len = (lex.pos - start_pos) as u32;
        tok.int_val = val;
        tok.hash = 0;
        return;
    }

    // 3. String Literals
    if c == 34 { // '"'
        while lex.pos < lex.len && lex.src[lex.pos] != 34 {
            if lex.src[lex.pos] == 92 { // '\\'
                lex.pos = lex.pos + 1;
            }
            lex.pos = lex.pos + 1;
            lex.col = lex.col + 1;
        }
        if lex.pos < lex.len {
            lex.pos = lex.pos + 1; // closing quote
            lex.col = lex.col + 1;
        }
        tok.kind = 3; // TOK_STRING
        tok.start = start_ptr;
        tok.len = (lex.pos - start_pos) as u32;
        tok.int_val = 0;
        tok.hash = 0;
        return;
    }

    // 4. Character Literals
    if c == 39 { // '\''
        while lex.pos < lex.len && lex.src[lex.pos] != 39 {
            lex.pos = lex.pos + 1;
            lex.col = lex.col + 1;
        }
        if lex.pos < lex.len {
            lex.pos = lex.pos + 1;
            lex.col = lex.col + 1;
        }
        tok.kind = 4; // TOK_CHAR
        tok.start = start_ptr;
        tok.len = (lex.pos - start_pos) as u32;
        tok.int_val = 0;
        tok.hash = 0;
        return;
    }

    // 5. Operators & Punctuation
    if c == 45 { // '-'
        if lex.pos < lex.len && lex.src[lex.pos] == 62 { // '->'
            lex.pos = lex.pos + 1;
            tok.kind = 74; // TOK_ARROW
        } else {
            tok.kind = 31; // TOK_MINUS
        }
    } else if c == 61 { // '='
        if lex.pos < lex.len && lex.src[lex.pos] == 61 { // '=='
            lex.pos = lex.pos + 1;
            tok.kind = 41; // TOK_EQEQ
        } else {
            tok.kind = 40; // TOK_EQ
        }
    } else if c == 33 { // '!'
        if lex.pos < lex.len && lex.src[lex.pos] == 61 { // '!='
            lex.pos = lex.pos + 1;
            tok.kind = 42; // TOK_NEQ
        } else {
            tok.kind = 54; // TOK_EXCL
        }
    } else if c == 60 { // '<'
        if lex.pos < lex.len && lex.src[lex.pos] == 60 { // '<<'
            lex.pos = lex.pos + 1;
            tok.kind = 47; // TOK_SHL
        } else if lex.pos < lex.len && lex.src[lex.pos] == 61 { // '<='
            lex.pos = lex.pos + 1;
            tok.kind = 45; // TOK_LTE
        } else {
            tok.kind = 43; // TOK_LT
        }
    } else if c == 62 { // '>'
        if lex.pos < lex.len && lex.src[lex.pos] == 62 { // '>>'
            lex.pos = lex.pos + 1;
            tok.kind = 48; // TOK_SHR
        } else if lex.pos < lex.len && lex.src[lex.pos] == 61 { // '>='
            lex.pos = lex.pos + 1;
            tok.kind = 46; // TOK_GTE
        } else {
            tok.kind = 44; // TOK_GT
        }
    } else if c == 43 { tok.kind = 30; } // '+'
    else if c == 42 { tok.kind = 32; } // '*'
    else if c == 47 { tok.kind = 33; } // '/'
    else if c == 37 { tok.kind = 34; } // '%'
    else if c == 38 { tok.kind = 50; } // '&'
    else if c == 124 { tok.kind = 51; } // '|'
    else if c == 94 { tok.kind = 52; } // '^'
    else if c == 126 { tok.kind = 53; } // '~'
    else if c == 40 { tok.kind = 60; } // '('
    else if c == 41 { tok.kind = 61; } // ')'
    else if c == 123 { tok.kind = 62; } // '{'
    else if c == 125 { tok.kind = 63; } // '}'
    else if c == 91 { tok.kind = 64; } // '['
    else if c == 93 { tok.kind = 65; } // ']'
    else if c == 58 { tok.kind = 70; } // ':'
    else if c == 59 { tok.kind = 71; } // ';'
    else if c == 44 { tok.kind = 72; } // ','
    else if c == 46 { tok.kind = 73; } // '.'
    else { tok.kind = 0; }

    tok.start = start_ptr;
    tok.len = (lex.pos - start_pos) as u32;
    tok.int_val = 0;
    tok.hash = 0;
}

// -------------------------------------------------------------------------
//                         5. Self-Hosted Parser
// -------------------------------------------------------------------------

struct AstNode {
    kind: u32,
    id: u64,
    hash: u64,
    val: u64,
    child1: *mut AstNode,
    child2: *mut AstNode,
    next: *mut AstNode,
}

struct Parser {
    lex: *mut Lexer,
    arena: *mut Arena,
    cur_tok: Token,
    node_count: u32,
    struct_count: u32,
    fn_count: u32,
}

fn alloc_node(p: *mut Parser, kind: u32) -> *mut AstNode {
    let node_ptr: *mut u8 = arena_alloc(p.arena, 56);
    let node: *mut AstNode = node_ptr as *mut AstNode;
    node.kind = kind;
    node.id = p.node_count as u64;
    node.hash = 0;
    node.val = 0;
    node.child1 = 0 as *mut AstNode;
    node.child2 = 0 as *mut AstNode;
    node.next = 0 as *mut AstNode;
    p.node_count = p.node_count + 1;
    return node;
}

fn parser_expect(p: *mut Parser, expected_kind: u32) {
    if p.cur_tok.kind == expected_kind {
        lex_next_token(p.lex, &mut p.cur_tok);
    }
}

fn parse_primary(p: *mut Parser) -> *mut AstNode {
    if p.cur_tok.kind == 2 { // TOK_INT
        let n: *mut AstNode = alloc_node(p, 116);
        n.val = p.cur_tok.int_val;
        lex_next_token(p.lex, &mut p.cur_tok);
        return n;
    }
    if p.cur_tok.kind == 1 { // TOK_IDENT
        let n: *mut AstNode = alloc_node(p, 117);
        n.hash = p.cur_tok.hash;
        lex_next_token(p.lex, &mut p.cur_tok);
        return n;
    }
    if p.cur_tok.kind == 3 { // TOK_STRING
        let n: *mut AstNode = alloc_node(p, 118);
        n.hash = p.cur_tok.start as u64; // Pointer to start of string
        n.val = p.cur_tok.len as u64;     // String token length
        lex_next_token(p.lex, &mut p.cur_tok);
        return n;
    }
    if p.cur_tok.kind == 18 { // TOK_SYSCALL
        let n: *mut AstNode = alloc_node(p, 119);
        parser_expect(p, 18);
        parser_expect(p, 60); // '('
        n.child1 = parse_expr(p); // nr
        let mut last_arg: *mut AstNode = 0 as *mut AstNode;
        while p.cur_tok.kind == 72 { // ','
            parser_expect(p, 72);
            let arg: *mut AstNode = parse_expr(p);
            if last_arg == (0 as *mut AstNode) {
                n.child2 = arg;
            } else {
                last_arg.next = arg;
            }
            last_arg = arg;
        }
        parser_expect(p, 61); // ')'
        return n;
    }
    if p.cur_tok.kind == 50 { // '&'
        parser_expect(p, 50);
        if p.cur_tok.kind == 13 { // 'mut'
            parser_expect(p, 13);
        }
        let n: *mut AstNode = alloc_node(p, 112);
        n.child1 = parse_expr(p);
        return n;
    }
    if p.cur_tok.kind == 32 { // '*'
        parser_expect(p, 32);
        let n: *mut AstNode = alloc_node(p, 112);
        n.child1 = parse_expr(p);
        return n;
    }

    if p.cur_tok.kind == 60 { // '('
        parser_expect(p, 60);
        let n: *mut AstNode = parse_expr(p);
        parser_expect(p, 61); // ')'
        return n;
    }

    let dummy: *mut AstNode = alloc_node(p, 0);
    lex_next_token(p.lex, &mut p.cur_tok);
    return dummy;
}

fn get_tok_prec(kind: u32) -> u32 {
    if kind == 51 { return 1; } // |
    if kind == 52 { return 2; } // ^
    if kind == 50 { return 3; } // &
    if kind == 41 || kind == 42 { return 4; } // ==, !=
    if kind == 43 || kind == 44 || kind == 45 || kind == 46 { return 5; } // <, >, <=, >=
    if kind == 47 || kind == 48 { return 6; } // <<, >>
    if kind == 30 || kind == 31 { return 7; } // +, -
    if kind == 32 || kind == 33 || kind == 34 { return 8; } // *, /, %
    return 0;
}

fn parse_expr_prec(p: *mut Parser, min_prec: u32) -> *mut AstNode {
    let mut left: *mut AstNode = parse_primary(p);

    let mut postfix_loop: u32 = 1;
    while postfix_loop == 1 {
        if p.cur_tok.kind == 73 { // '.'
            parser_expect(p, 73);
            let fa: *mut AstNode = alloc_node(p, 114);
            fa.child1 = left;
            fa.hash = p.cur_tok.hash;
            parser_expect(p, 1);
            left = fa;
        } else if p.cur_tok.kind == 19 { // 'as'
            parser_expect(p, 19);
            lex_next_token(p.lex, &mut p.cur_tok);
        } else if p.cur_tok.kind == 64 { // '['
            parser_expect(p, 64);
            let idx: *mut AstNode = alloc_node(p, 115);
            idx.child1 = left;
            idx.child2 = parse_expr_prec(p, 0);
            parser_expect(p, 65);
            left = idx;
        } else if p.cur_tok.kind == 60 { // '(' function call
            parser_expect(p, 60);
            let call_node: *mut AstNode = alloc_node(p, 113); // NODE_CALL
            call_node.child1 = left;
            call_node.hash = left.hash;
            let mut last_arg: *mut AstNode = 0 as *mut AstNode;
            while p.cur_tok.kind != 61 && p.cur_tok.kind != 0 {
                let arg: *mut AstNode = parse_expr_prec(p, 0);
                if last_arg == (0 as *mut AstNode) {
                    call_node.child2 = arg;
                } else {
                    last_arg.next = arg;
                }
                last_arg = arg;
                if p.cur_tok.kind == 72 { // ','
                    parser_expect(p, 72);
                }
            }
            parser_expect(p, 61); // ')'
            left = call_node;
        } else {
            postfix_loop = 0;
        }
    }

    while get_tok_prec(p.cur_tok.kind) >= min_prec && get_tok_prec(p.cur_tok.kind) > 0 {
        let op_tok: u32 = p.cur_tok.kind;
        let prec: u32 = get_tok_prec(op_tok);
        lex_next_token(p.lex, &mut p.cur_tok);
        let right: *mut AstNode = parse_expr_prec(p, prec + 1);

        let bin: *mut AstNode = alloc_node(p, 106); // NODE_BINARY
        bin.val = op_tok as u64;
        bin.child1 = left;
        bin.child2 = right;
        left = bin;
    }

    return left;
}

fn parse_expr(p: *mut Parser) -> *mut AstNode {
    return parse_expr_prec(p, 0);
}

fn parse_stmt(p: *mut Parser) -> *mut AstNode {
    if p.cur_tok.kind == 12 { // TOK_LET
        let sn: *mut AstNode = alloc_node(p, 105);
        parser_expect(p, 12);
        if p.cur_tok.kind == 13 { // TOK_MUT
            parser_expect(p, 13);
        }
        sn.hash = p.cur_tok.hash; // Variable name hash
        parser_expect(p, 1);
        parser_expect(p, 70); // ':'

        // Parse variable type
        if p.cur_tok.kind == 64 { // '[' array type [T; N]
            parser_expect(p, 64);
            let mut elem_is_byte: u32 = 0;
            if p.cur_tok.kind == 23 { // u8
                elem_is_byte = 1;
                lex_next_token(p.lex, &mut p.cur_tok);
            } else {
                while p.cur_tok.kind != 71 && p.cur_tok.kind != 0 {
                    lex_next_token(p.lex, &mut p.cur_tok);
                }
            }
            parser_expect(p, 71); // ';'
            let arr_len: u64 = p.cur_tok.int_val;
            parser_expect(p, 2); // TOK_INT
            parser_expect(p, 65); // ']'

            if elem_is_byte == 1 {
                sn.val = arr_len;
                sn.id = 10; // u8 array
            } else {
                sn.val = arr_len * 8;
                sn.id = 11; // 8-byte array
            }
        } else if p.cur_tok.kind == 32 { // '*'
            parser_expect(p, 32);
            if p.cur_tok.kind == 13 { // 'mut'
                parser_expect(p, 13);
            }
            if p.cur_tok.kind == 1 { // struct identifier
                sn.val = p.cur_tok.hash; // pointee struct hash
                sn.id = 1;               // flag: pointer to struct
                lex_next_token(p.lex, &mut p.cur_tok);
            } else {
                sn.val = p.cur_tok.kind as u64;
                sn.id = 2; // pointer to primitive
                lex_next_token(p.lex, &mut p.cur_tok);
            }
        } else if p.cur_tok.kind == 1 { // struct identifier directly
            sn.val = p.cur_tok.hash;
            sn.id = 3; // flag: struct value
            lex_next_token(p.lex, &mut p.cur_tok);
        } else {
            sn.val = p.cur_tok.kind as u64;
            sn.id = 0; // primitive
            lex_next_token(p.lex, &mut p.cur_tok);
        }

        if p.cur_tok.kind == 40 { // '='
            parser_expect(p, 40);
            sn.child1 = parse_expr(p);
        }
        parser_expect(p, 71); // ';'
        return sn;
    }

    if p.cur_tok.kind == 17 { // TOK_RETURN
        let sn: *mut AstNode = alloc_node(p, 109);
        parser_expect(p, 17);
        if p.cur_tok.kind != 71 {
            sn.child1 = parse_expr(p);
        }
        parser_expect(p, 71);
        return sn;
    }

    if p.cur_tok.kind == 14 { // TOK_IF
        let sn: *mut AstNode = alloc_node(p, 107);
        parser_expect(p, 14);
        sn.child1 = parse_expr(p);
        parser_expect(p, 62); // '{'
        let mut last_bs: *mut AstNode = 0 as *mut AstNode;
        while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
            let bs: *mut AstNode = parse_stmt(p);
            if last_bs == (0 as *mut AstNode) {
                sn.child2 = bs;
            } else {
                last_bs.next = bs;
            }
            last_bs = bs;
        }
        parser_expect(p, 63); // '}'
        return sn;
    }

    if p.cur_tok.kind == 16 { // TOK_WHILE
        let sn: *mut AstNode = alloc_node(p, 108);
        parser_expect(p, 16);
        sn.child1 = parse_expr(p);
        parser_expect(p, 62); // '{'
        let mut last_bs: *mut AstNode = 0 as *mut AstNode;
        while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
            let bs: *mut AstNode = parse_stmt(p);
            if last_bs == (0 as *mut AstNode) {
                sn.child2 = bs;
            } else {
                last_bs.next = bs;
            }
            last_bs = bs;
        }
        parser_expect(p, 63); // '}'
        return sn;
    }

    let expr_node: *mut AstNode = parse_expr(p);
    if p.cur_tok.kind == 40 { // '='
        let asn: *mut AstNode = alloc_node(p, 106);
        asn.child1 = expr_node;
        parser_expect(p, 40);
        asn.child2 = parse_expr(p);
        parser_expect(p, 71); // ';'
        return asn;
    }

    parser_expect(p, 71); // ';'
    let esn: *mut AstNode = alloc_node(p, 110);
    esn.child1 = expr_node;
    return esn;
}

fn parse_struct(p: *mut Parser) -> *mut AstNode {
    let snode: *mut AstNode = alloc_node(p, 100); // NODE_STRUCT
    parser_expect(p, 10); // TOK_STRUCT
    snode.hash = p.cur_tok.hash;
    parser_expect(p, 1);
    parser_expect(p, 62); // '{'

    let mut last_f: *mut AstNode = 0 as *mut AstNode;
    while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
        let fnode: *mut AstNode = alloc_node(p, 101); // NODE_FIELD
        fnode.hash = p.cur_tok.hash;
        parser_expect(p, 1);
        parser_expect(p, 70); // ':'
        fnode.val = p.cur_tok.kind as u64;
        lex_next_token(p.lex, &mut p.cur_tok);
        if p.cur_tok.kind == 72 { // ','
            parser_expect(p, 72);
        }
        if last_f == (0 as *mut AstNode) {
            snode.child1 = fnode;
        } else {
            last_f.next = fnode;
        }
        last_f = fnode;
    }

    parser_expect(p, 63); // '}'
    p.struct_count = p.struct_count + 1;
    return snode;
}

fn parse_fn(p: *mut Parser) -> *mut AstNode {
    let fnode: *mut AstNode = alloc_node(p, 102); // NODE_FN
    parser_expect(p, 11); // TOK_FN
    fnode.hash = p.cur_tok.hash;
    parser_expect(p, 1);
    parser_expect(p, 60); // '('

    let mut last_param: *mut AstNode = 0 as *mut AstNode;
    while p.cur_tok.kind != 61 && p.cur_tok.kind != 0 {
        let pnode: *mut AstNode = alloc_node(p, 101); // NODE_PARAM
        pnode.hash = p.cur_tok.hash;
        parser_expect(p, 1);
        parser_expect(p, 70); // ':'
        let mut is_ptr: u32 = 0;
        if p.cur_tok.kind == 50 { parser_expect(p, 50); is_ptr = 1; } // '&'
        if p.cur_tok.kind == 13 { parser_expect(p, 13); is_ptr = 2; } // 'mut'
        if p.cur_tok.kind == 32 { parser_expect(p, 32); is_ptr = 1; } // '*'
        if p.cur_tok.kind == 13 { parser_expect(p, 13); is_ptr = 2; } // 'mut'
        pnode.val = p.cur_tok.hash;
        pnode.is_mut = is_ptr;
        lex_next_token(p.lex, &mut p.cur_tok);
        if last_param == (0 as *mut AstNode) {
            fnode.child2 = pnode;
        } else {
            last_param.next = pnode;
        }
        last_param = pnode;
        if p.cur_tok.kind == 72 { // ','
            parser_expect(p, 72);
        }
    }
    parser_expect(p, 61); // ')'

    let mut ret_hash: u64 = 3563412735833858527; // "void"
    if p.cur_tok.kind == 74 { // '->'
        parser_expect(p, 74);
        ret_hash = p.cur_tok.hash;
        lex_next_token(p.lex, &mut p.cur_tok);
    }
    fnode.val = ret_hash;

    parser_expect(p, 62); // '{'
    let mut last_stmt: *mut AstNode = 0 as *mut AstNode;
    while p.cur_tok.kind != 63 && p.cur_tok.kind != 0 {
        let stmt: *mut AstNode = parse_stmt(p);
        if last_stmt == (0 as *mut AstNode) {
            fnode.child1 = stmt;
        } else {
            last_stmt.next = stmt;
        }
        last_stmt = stmt;
    }

    parser_expect(p, 63); // '}'
    p.fn_count = p.fn_count + 1;
    return fnode;
}

// -------------------------------------------------------------------------
//                         6. Stage-1 Machine Code Emitter
// -------------------------------------------------------------------------

struct FieldInfo {
    name_hash: u64,
    byte_offset: u32,
    field_size: u32,
    type_kind: u32,
}

struct StructInfo {
    name_hash: u64,
    type_sig_hash: u64,
    total_size: u32,
    field_count: u32,
    fields: *mut FieldInfo,
}

struct LocalVar {
    name_hash: u64,
    rbp_offset: u32,
    size: u32,
    is_struct_ptr: u32,
    is_struct_val: u32,
    struct_hash: u64,
}

struct CodeGen {
    text_buf: *mut u8,
    text_size: u32,

    rodata_buf: *mut u8,
    rodata_size: u32,

    relocs: *mut EiaRelocHole,
    reloc_count: u32,

    type_graph: *mut EiaTypeGraphEntry,
    tg_count: u32,

    contracts: *mut SymbolContract,
    contract_count: u32,

    call_main_hole: u32,

    structs: *mut StructInfo,
    struct_count: u32,

    locals: *mut LocalVar,
    local_count: u32,
    current_stack_offset: u32,
    force_bridge: u32,
    permute_seed: u32,
    target_arch: u32,
}

fn cg_emit8(cg: *mut CodeGen, b: u8) {
    cg.text_buf[cg.text_size as u64] = b;
    cg.text_size = cg.text_size + 1;
}

fn cg_emit32(cg: *mut CodeGen, val: u32) {
    cg_emit8(cg, (val & 255) as u8);
    cg_emit8(cg, ((val >> 8) & 255) as u8);
    cg_emit8(cg, ((val >> 16) & 255) as u8);
    cg_emit8(cg, ((val >> 24) & 255) as u8);
}

fn cg_emit64(cg: *mut CodeGen, val: u64) {
    cg_emit32(cg, (val & 4294967295) as u32);
    cg_emit32(cg, ((val >> 32) & 4294967295) as u32);
}

fn cg_patch32(cg: *mut CodeGen, offset: u32, val: u32) {
    cg.text_buf[offset as u64] = (val & 255) as u8;
    cg.text_buf[(offset + 1) as u64] = ((val >> 8) & 255) as u8;
    cg.text_buf[(offset + 2) as u64] = ((val >> 16) & 255) as u8;
    cg.text_buf[(offset + 3) as u64] = ((val >> 24) & 255) as u8;
}

fn cg_add_reloc(cg: *mut CodeGen, insn_offset: u32, type_hash: u64, field_hash: u64) {
    let hole: *mut EiaRelocHole = ((cg.relocs as *mut u8) + ((cg.reloc_count as u64) * 24)) as *mut EiaRelocHole;
    hole.insn_offset = insn_offset;
    hole.patch_kind = 1; // EIA_PATCH_FIELD_DISP32
    hole.type_sig_hash = type_hash;
    hole.field_or_sym_hash = field_hash;
    cg.reloc_count = cg.reloc_count + 1;
}

fn cg_add_reloc_ex(cg: *mut CodeGen, insn_offset: u32, patch_kind: u32, type_hash: u64, field_or_sym_hash: u64) {
    let hole: *mut EiaRelocHole = ((cg.relocs as *mut u8) + ((cg.reloc_count as u64) * 24)) as *mut EiaRelocHole;
    hole.insn_offset = insn_offset;
    hole.patch_kind = patch_kind;
    hole.type_sig_hash = type_hash;
    hole.field_or_sym_hash = field_or_sym_hash;
    cg.reloc_count = cg.reloc_count + 1;
}

fn cg_add_type_graph_entry(cg: *mut CodeGen, type_hash: u64, field_hash: u64, byte_offset: u32, field_size: u32) {
    let entry: *mut EiaTypeGraphEntry = ((cg.type_graph as *mut u8) + ((cg.tg_count as u64) * 24)) as *mut EiaTypeGraphEntry;
    entry.type_sig_hash = type_hash;
    entry.field_hash = field_hash;
    entry.byte_offset = byte_offset;
    entry.field_size = field_size;
    cg.tg_count = cg.tg_count + 1;
}

fn cg_find_local(cg: *mut CodeGen, name_hash: u64) -> *mut LocalVar {
    let mut i: u32 = 0;
    while i < cg.local_count {
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((i as u64) * 32)) as *mut LocalVar;
        if lv.name_hash == name_hash {
            return lv;
        }
        i = i + 1;
    }
    return 0 as *mut LocalVar;
}

fn cg_find_struct(cg: *mut CodeGen, name_hash: u64) -> *mut StructInfo {
    let mut i: u32 = 0;
    while i < cg.struct_count {
        let si: *mut StructInfo = ((cg.structs as *mut u8) + ((i as u64) * 32)) as *mut StructInfo;
        if si.name_hash == name_hash {
            return si;
        }
        i = i + 1;
    }
    return 0 as *mut StructInfo;
}

// -------------------------------------------------------------------------
//                         7. _start Boot Patcher Stub
// -------------------------------------------------------------------------

fn emit_start_stub(cg: *mut CodeGen) {
    if cg.target_arch == 1 {
        // ARM64 start stub:
        // mov x0, 42       ; 0xd2800540
        // mov x8, 93       ; 0xd2800ba8 (SYS_exit)
        // svc 0            ; 0xd4000001
        cg_emit32(cg, 3531669824);
        cg_emit32(cg, 3531672488);
        cg_emit32(cg, 3556769793);
        return;
    }
    if cg.target_arch == 2 {
        // RISC-V 64 start stub:
        // li a0, 42        ; 0x02a00513 (addi a0, zero, 42)
        // li a7, 93        ; 0x05d00893 (addi a7, zero, 93 - SYS_exit)
        // ecall            ; 0x00000073
        cg_emit32(cg, 44041491);
        cg_emit32(cg, 97521811);
        cg_emit32(cg, 115);
        return;
    }

    // 0. Preserve argc and argv from stack
    cg_emit8(cg, 72); cg_emit8(cg, 139); cg_emit8(cg, 60); cg_emit8(cg, 36); // mov rdi, [rsp]
    cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 116); cg_emit8(cg, 36); cg_emit8(cg, 8); // lea rsi, [rsp + 8]
    cg_emit8(cg, 87); // push rdi
    cg_emit8(cg, 86); // push rsi

    // 1. sys_mprotect(0x400000, 0x200000, 7) - temporary write access for hole patching
    cg_emit8(cg, 184); cg_emit32(cg, 10);        // mov eax, 10
    cg_emit8(cg, 191); cg_emit32(cg, 4194304);   // mov edi, 0x400000
    cg_emit8(cg, 190); cg_emit32(cg, 2097152);   // mov esi, 0x200000 (2MB)
    cg_emit8(cg, 186); cg_emit32(cg, 7);         // mov edx, 7
    cg_emit8(cg, 15); cg_emit8(cg, 5);           // syscall

    // 2. Hologram Boot Patcher
    // mov r12, 0x400480 (UPBP Hologram Header)
    cg_emit8(cg, 73); cg_emit8(cg, 199); cg_emit8(cg, 196); cg_emit32(cg, 4195456);
    // cmp dword ptr [r12], 0x44484945 ('EIAH')
    cg_emit8(cg, 65); cg_emit8(cg, 129); cg_emit8(cg, 60); cg_emit8(cg, 36); cg_emit32(cg, 1145588037);
    // je .Lfound (+7 bytes)
    cg_emit8(cg, 116); cg_emit8(cg, 7);
    // mov r12, 0x400080 (Native ELF Hologram Header)
    cg_emit8(cg, 73); cg_emit8(cg, 199); cg_emit8(cg, 196); cg_emit32(cg, 4194432);
    // .Lfound:
    // mov r13, [r12 + 0x20]
    cg_emit8(cg, 77); cg_emit8(cg, 139); cg_emit8(cg, 108); cg_emit8(cg, 36); cg_emit8(cg, 32);
    // add r13, 0x400000
    cg_emit8(cg, 73); cg_emit8(cg, 129); cg_emit8(cg, 197); cg_emit32(cg, 4194304);
    // mov r14, [r12 + 0x28]
    cg_emit8(cg, 77); cg_emit8(cg, 139); cg_emit8(cg, 116); cg_emit8(cg, 36); cg_emit8(cg, 40);
    // mov r15, [r12 + 0x30]
    cg_emit8(cg, 77); cg_emit8(cg, 139); cg_emit8(cg, 124); cg_emit8(cg, 36); cg_emit8(cg, 48);
    // add r15, 0x400000
    cg_emit8(cg, 73); cg_emit8(cg, 129); cg_emit8(cg, 199); cg_emit32(cg, 4194304);
    // mov rcx, [r12 + 0x38]
    cg_emit8(cg, 73); cg_emit8(cg, 139); cg_emit8(cg, 76); cg_emit8(cg, 36); cg_emit8(cg, 56);
    // add rcx, r15
    cg_emit8(cg, 76); cg_emit8(cg, 1); cg_emit8(cg, 249);

    // .Lreloc_loop:
    let reloc_loop_offset: u32 = cg.text_size;
    // test r14, r14
    cg_emit8(cg, 77); cg_emit8(cg, 133); cg_emit8(cg, 246);
    // jz .Lpatch_done
    cg_emit8(cg, 15); cg_emit8(cg, 132);
    let jz_patch_done_hole: u32 = cg.text_size;
    cg_emit32(cg, 0);

    // mov r8d, [r13 + 0x00]
    cg_emit8(cg, 69); cg_emit8(cg, 139); cg_emit8(cg, 69); cg_emit8(cg, 0);
    // mov r9, [r13 + 0x08]
    cg_emit8(cg, 77); cg_emit8(cg, 139); cg_emit8(cg, 77); cg_emit8(cg, 8);
    // mov r10, [r13 + 0x10]
    cg_emit8(cg, 77); cg_emit8(cg, 139); cg_emit8(cg, 85); cg_emit8(cg, 16);

    // mov rsi, r15
    cg_emit8(cg, 76); cg_emit8(cg, 137); cg_emit8(cg, 254);

    // .Ltype_loop:
    let type_loop_offset: u32 = cg.text_size;
    // cmp rsi, rcx
    cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 206);
    // jae .Lnext_reloc
    cg_emit8(cg, 15); cg_emit8(cg, 131);
    let jae_next_reloc_hole: u32 = cg.text_size;
    cg_emit32(cg, 0);

    // cmp [rsi], r9
    cg_emit8(cg, 76); cg_emit8(cg, 57); cg_emit8(cg, 14);
    // jne .Lnext_type
    cg_emit8(cg, 15); cg_emit8(cg, 133);
    let jne_next_type1_hole: u32 = cg.text_size;
    cg_emit32(cg, 0);

    // cmp [rsi + 0x08], r10
    cg_emit8(cg, 76); cg_emit8(cg, 57); cg_emit8(cg, 86); cg_emit8(cg, 8);
    // jne .Lnext_type
    cg_emit8(cg, 15); cg_emit8(cg, 133);
    let jne_next_type2_hole: u32 = cg.text_size;
    cg_emit32(cg, 0);

    // Match found:
    // mov eax, [rsi + 0x10]
    cg_emit8(cg, 139); cg_emit8(cg, 70); cg_emit8(cg, 16);
    // mov rdi, 0x410000 (TEXT_VADDR)
    cg_emit8(cg, 72); cg_emit8(cg, 199); cg_emit8(cg, 199); cg_emit32(cg, 4259840);
    // add rdi, r8
    cg_emit8(cg, 76); cg_emit8(cg, 1); cg_emit8(cg, 199);
    // mov [rdi], eax (PATCH!)
    cg_emit8(cg, 137); cg_emit8(cg, 7);
    // jmp .Lnext_reloc
    cg_emit8(cg, 233);
    let jmp_next_reloc_hole: u32 = cg.text_size;
    cg_emit32(cg, 0);

    // .Lnext_type:
    let next_type_offset: u32 = cg.text_size;
    cg_patch32(cg, jne_next_type1_hole, next_type_offset - (jne_next_type1_hole + 4));
    cg_patch32(cg, jne_next_type2_hole, next_type_offset - (jne_next_type2_hole + 4));
    // add rsi, 24
    cg_emit8(cg, 72); cg_emit8(cg, 131); cg_emit8(cg, 198); cg_emit8(cg, 24);
    // jmp .Ltype_loop
    cg_emit8(cg, 233);
    let jmp_type_loop: i32 = (type_loop_offset as i32) - ((cg.text_size + 4) as i32);
    cg_emit32(cg, jmp_type_loop as u32);

    // .Lnext_reloc:
    let next_reloc_offset: u32 = cg.text_size;
    cg_patch32(cg, jae_next_reloc_hole, next_reloc_offset - (jae_next_reloc_hole + 4));
    cg_patch32(cg, jmp_next_reloc_hole, next_reloc_offset - (jmp_next_reloc_hole + 4));
    // add r13, 24
    cg_emit8(cg, 73); cg_emit8(cg, 131); cg_emit8(cg, 197); cg_emit8(cg, 24);
    // dec r14
    cg_emit8(cg, 73); cg_emit8(cg, 255); cg_emit8(cg, 206);
    // jmp .Lreloc_loop
    cg_emit8(cg, 233);
    let jmp_reloc_loop: i32 = (reloc_loop_offset as i32) - ((cg.text_size + 4) as i32);
    cg_emit32(cg, jmp_reloc_loop as u32);

    // .Lpatch_done:
    let patch_done_offset: u32 = cg.text_size;
    cg_patch32(cg, jz_patch_done_hole, patch_done_offset - (jz_patch_done_hole + 4));

    // 3. HASI Cache fence: CPUID + mfence
    cg_emit8(cg, 49); cg_emit8(cg, 192); // xor eax, eax
    cg_emit8(cg, 15); cg_emit8(cg, 162); // cpuid
    cg_emit8(cg, 15); cg_emit8(cg, 174); cg_emit8(cg, 240); // mfence

    // 3b. Strict W^X: sys_mprotect(0x400000, 0x200000, 5) (PROT_READ | PROT_EXEC - strictly non-writable)
    cg_emit8(cg, 184); cg_emit32(cg, 10);        // mov eax, 10
    cg_emit8(cg, 191); cg_emit32(cg, 4194304);   // mov edi, 0x400000
    cg_emit8(cg, 190); cg_emit32(cg, 2097152);   // mov esi, 0x200000 (2MB)
    cg_emit8(cg, 186); cg_emit32(cg, 5);         // mov edx, 5 (PROT_READ | PROT_EXEC)
    cg_emit8(cg, 15); cg_emit8(cg, 5);           // syscall

    // 4. call main(argc, argv)
    cg_emit8(cg, 94); // pop rsi (argv)
    cg_emit8(cg, 95); // pop rdi (argc)
    cg_emit8(cg, 232);
    cg.call_main_hole = cg.text_size;
    cg_emit32(cg, 0);

    // 5. exit: mov rdi, rax; mov eax, 60; syscall
    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 199);
    cg_emit8(cg, 184); cg_emit32(cg, 60);
    cg_emit8(cg, 15); cg_emit8(cg, 5);
}

// -------------------------------------------------------------------------
//                         8. Code Generator Engine
// -------------------------------------------------------------------------

fn compile_expr(cg: *mut CodeGen, node: *mut AstNode) {
    if node == (0 as *mut AstNode) { return; }

    if node.kind == 116 { // NODE_INT
        // mov rax, imm64
        cg_emit8(cg, 72); cg_emit8(cg, 184);
        cg_emit64(cg, node.val);
        return;
    }

    if node.kind == 118 { // NODE_STRING
        let s_ptr: *u8 = node.hash as *u8;
        let s_len: u32 = node.val as u32;

        let rodata_off: u32 = cg.rodata_size;
        let mut si: u32 = 1;
        let s_end: u32 = s_len - 1;
        while si < s_end {
            let sc: u8 = s_ptr[si as u64];
            if sc == 92 && (si + 1) < s_end { // '\\'
                si = si + 1;
                let esc: u8 = s_ptr[si as u64];
                if esc == 110 { // 'n'
                    cg.rodata_buf[cg.rodata_size as u64] = 10;
                } else if esc == 116 { // 't'
                    cg.rodata_buf[cg.rodata_size as u64] = 9;
                } else if esc == 114 { // 'r'
                    cg.rodata_buf[cg.rodata_size as u64] = 13;
                } else {
                    cg.rodata_buf[cg.rodata_size as u64] = esc;
                }
            } else {
                cg.rodata_buf[cg.rodata_size as u64] = sc;
            }
            cg.rodata_size = cg.rodata_size + 1;
            si = si + 1;
        }
        cg.rodata_buf[cg.rodata_size as u64] = 0; // null terminator
        cg.rodata_size = cg.rodata_size + 1;

        // mov rax, 0x430000 + rodata_off
        let vaddr: u64 = 4390912 + (rodata_off as u64); // 0x430000 = 4390912
        cg_emit8(cg, 72); cg_emit8(cg, 184);
        cg_emit64(cg, vaddr);
        return;
    }

    if node.kind == 117 { // NODE_IDENT
        let lv: *mut LocalVar = cg_find_local(cg, node.hash);
        if lv != (0 as *mut LocalVar) {
            if lv.is_struct_val == 1 {
                // Address of struct variable: lea rax, [rbp - rbp_offset]
                cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 133);
                cg_emit32(cg, 0 - lv.rbp_offset);
            } else {
                // mov rax, [rbp - rbp_offset]
                cg_emit8(cg, 72); cg_emit8(cg, 139); cg_emit8(cg, 133);
                cg_emit32(cg, 0 - lv.rbp_offset);
            }
        }
        return;
    }

    if node.kind == 112 { // NODE_UNARY (&mut, *)
        let operand: *mut AstNode = node.child1;
        if operand != (0 as *mut AstNode) {
            if operand.kind == 117 { // &ident
                let lv: *mut LocalVar = cg_find_local(cg, operand.hash);
                if lv != (0 as *mut LocalVar) {
                    // lea rax, [rbp - rbp_offset]
                    cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 133);
                    cg_emit32(cg, 0 - lv.rbp_offset);
                    return;
                }
            } else if operand.kind == 115 { // &arr[idx]
                compile_expr(cg, operand.child1); // base pointer in rax
                cg_emit8(cg, 80);                 // push rax
                compile_expr(cg, operand.child2); // index in rax
                cg_emit8(cg, 91);                 // pop rbx (base)

                let mut is_byte: u32 = 1;
                if operand.child1.kind == 117 {
                    let lv: *mut LocalVar = cg_find_local(cg, operand.child1.hash);
                    if lv != (0 as *mut LocalVar) && lv.is_struct_ptr == 11 {
                        is_byte = 0;
                    }
                }

                if is_byte == 1 {
                    cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 195); // add rbx, rax
                } else {
                    cg_emit8(cg, 72); cg_emit8(cg, 193); cg_emit8(cg, 224); cg_emit8(cg, 3); // shl rax, 3
                    cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 195); // add rbx, rax
                }
                // Address in rbx -> mov rax, rbx
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 216);
                return;
            }
        }
        compile_expr(cg, operand);
        return;
    }

    if node.kind == 114 { // NODE_FIELD_ACCESS (p.field)
        let base: *mut AstNode = node.child1;
        let mut s_hash: u64 = 0;
        if base != (0 as *mut AstNode) && base.kind == 117 {
            let lv: *mut LocalVar = cg_find_local(cg, base.hash);
            if lv != (0 as *mut LocalVar) {
                s_hash = lv.struct_hash;
            }
        }
        if s_hash == 0 && cg.struct_count > 0 {
            let first_s: *mut StructInfo = cg.structs;
            s_hash = first_s.type_sig_hash;
        }

        // Evaluate base pointer into rax -> rsi
        compile_expr(cg, base);
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198); // mov rsi, rax

        // CRITICAL EIA: Emit lea rdi, [rsi + 0x00000000] with 32-bit relocatable hole
        // 48 8d be 00 00 00 00
        cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 190);
        let hole_offset: u32 = cg.text_size;
        cg_emit32(cg, 0);
        cg_add_reloc(cg, hole_offset, s_hash, node.hash);

        // If field is struct-valued (cur_tok), return address in rax
        if node.hash == 6782429180816288216 {
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 248); // mov rax, rdi
            return;
        }

        // Load field into rax: mov rax, [rdi] (48 8b 07)
        cg_emit8(cg, 72); cg_emit8(cg, 139); cg_emit8(cg, 7);
        return;
    }

    if node.kind == 119 { // NODE_SYSCALL
        // Push arguments
        let mut args: [*mut AstNode; 8];
        let mut argc: u32 = 0;
        let mut cur_arg: *mut AstNode = node.child2;
        while cur_arg != (0 as *mut AstNode) && argc < 6 {
            args[argc as u64] = cur_arg;
            argc = argc + 1;
            cur_arg = cur_arg.next;
        }

        let mut idx: u32 = argc;
        while idx > 0 {
            idx = idx - 1;
            compile_expr(cg, args[idx as u64]);
            cg_emit8(cg, 80); // push rax
        }

        // Evaluate nr
        compile_expr(cg, node.child1);
        cg_emit8(cg, 80); // push rax (nr)

        // Pop registers
        cg_emit8(cg, 88); // pop rax (nr)
        if argc >= 1 { cg_emit8(cg, 95); } // pop rdi
        if argc >= 2 { cg_emit8(cg, 94); } // pop rsi
        if argc >= 3 { cg_emit8(cg, 90); } // pop rdx
        if argc >= 4 { cg_emit8(cg, 65); cg_emit8(cg, 90); } // pop r10
        if argc >= 5 { cg_emit8(cg, 65); cg_emit8(cg, 88); } // pop r8
        if argc >= 6 { cg_emit8(cg, 65); cg_emit8(cg, 89); } // pop r9

        cg_emit8(cg, 15); cg_emit8(cg, 5); // syscall
        return;
    }

    if node.kind == 115 { // NODE_INDEX (arr[idx])
        compile_expr(cg, node.child1); // base pointer in rax
        cg_emit8(cg, 80);              // push rax
        compile_expr(cg, node.child2); // index in rax
        cg_emit8(cg, 91);              // pop rbx (base)

        let mut is_byte: u32 = 1;
        if node.child1.kind == 117 {
            let lv: *mut LocalVar = cg_find_local(cg, node.child1.hash);
            if lv != (0 as *mut LocalVar) && lv.is_struct_ptr == 11 {
                is_byte = 0;
            }
        }

        if is_byte == 1 {
            cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 195); // add rbx, rax
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 3); // movzx rax, byte ptr [rbx]
        } else {
            cg_emit8(cg, 72); cg_emit8(cg, 193); cg_emit8(cg, 224); cg_emit8(cg, 3); // shl rax, 3
            cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 195); // add rbx, rax
            cg_emit8(cg, 72); cg_emit8(cg, 139); cg_emit8(cg, 3); // mov rax, [rbx]
        }
        return;
    }

    if node.kind == 106 { // NODE_BINARY
        let op: u32 = node.val as u32;
        compile_expr(cg, node.child1); // left in rax
        cg_emit8(cg, 80);              // push rax
        compile_expr(cg, node.child2); // right in rax
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 195); // mov rbx, rax
        cg_emit8(cg, 88);              // pop rax (left in rax)

        if op == 30 { // '+'
            cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 216); // add rax, rbx
        } else if op == 31 { // '-'
            cg_emit8(cg, 72); cg_emit8(cg, 41); cg_emit8(cg, 216); // sub rax, rbx
        } else if op == 32 { // '*'
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 175); cg_emit8(cg, 195); // imul rax, rbx
        } else if op == 33 { // '/'
            cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 210); // xor rdx, rdx
            cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 243); // div rbx
        } else if op == 34 { // '%'
            cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 210); // xor rdx, rdx
            cg_emit8(cg, 72); cg_emit8(cg, 247); cg_emit8(cg, 243); // div rbx
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 208); // mov rax, rdx
        } else if op == 50 { // '&'
            cg_emit8(cg, 72); cg_emit8(cg, 33); cg_emit8(cg, 216); // and rax, rbx
        } else if op == 51 { // '|'
            cg_emit8(cg, 72); cg_emit8(cg, 9); cg_emit8(cg, 216); // or rax, rbx
        } else if op == 52 { // '^'
            cg_emit8(cg, 72); cg_emit8(cg, 49); cg_emit8(cg, 216); // xor rax, rbx
        } else if op == 47 { // '<<'
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 217); // mov rcx, rbx
            cg_emit8(cg, 72); cg_emit8(cg, 211); cg_emit8(cg, 224); // shl rax, cl
        } else if op == 48 { // '>>'
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 217); // mov rcx, rbx
            cg_emit8(cg, 72); cg_emit8(cg, 211); cg_emit8(cg, 232); // shr rax, cl
        } else if op == 41 { // '=='
            cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);  // cmp rax, rbx
            cg_emit8(cg, 15); cg_emit8(cg, 148); cg_emit8(cg, 192); // sete al
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192); // movzx rax, al
        } else if op == 42 { // '!='
            cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);  // cmp rax, rbx
            cg_emit8(cg, 15); cg_emit8(cg, 149); cg_emit8(cg, 192); // setne al
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192); // movzx rax, al
        } else if op == 43 { // '<'
            cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);  // cmp rax, rbx
            cg_emit8(cg, 15); cg_emit8(cg, 146); cg_emit8(cg, 192); // setb al
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192); // movzx rax, al
        } else if op == 44 { // '>'
            cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);  // cmp rax, rbx
            cg_emit8(cg, 15); cg_emit8(cg, 147); cg_emit8(cg, 192); // seta al
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192); // movzx rax, al
        } else if op == 45 { // '<='
            cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);  // cmp rax, rbx
            cg_emit8(cg, 15); cg_emit8(cg, 150); cg_emit8(cg, 192); // setbe al
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192); // movzx rax, al
        } else if op == 46 { // '>='
            cg_emit8(cg, 72); cg_emit8(cg, 57); cg_emit8(cg, 216);  // cmp rax, rbx
            cg_emit8(cg, 15); cg_emit8(cg, 151); cg_emit8(cg, 192); // setae al
            cg_emit8(cg, 72); cg_emit8(cg, 15); cg_emit8(cg, 182); cg_emit8(cg, 192); // movzx rax, al
        }
        return;
    }

    if node.kind == 113 { // NODE_CALL
        // Evaluate and pass arguments
        let mut cur_a: *mut AstNode = node.child2;
        let mut a_cnt: u32 = 0;
        while cur_a != (0 as *mut AstNode) && a_cnt < 6 {
            compile_expr(cg, cur_a);
            cg_emit8(cg, 80); // push rax
            a_cnt = a_cnt + 1;
            cur_a = cur_a.next;
        }
        // Pop in reverse order to SysV ABI argument registers
        let mut pop_i: u32 = a_cnt;
        while pop_i > 0 {
            pop_i = pop_i - 1;
            if pop_i == 5 { cg_emit8(cg, 65); cg_emit8(cg, 89); } // pop r9
            else if pop_i == 4 { cg_emit8(cg, 65); cg_emit8(cg, 88); } // pop r8
            else if pop_i == 3 { cg_emit8(cg, 89); } // pop rcx
            else if pop_i == 2 { cg_emit8(cg, 90); } // pop rdx
            else if pop_i == 1 { cg_emit8(cg, 94); } // pop rsi
            else if pop_i == 0 { cg_emit8(cg, 95); } // pop rdi
        }

        // Emit call rel32 (E8 xx xx xx xx)
        cg_emit8(cg, 232); // 0xE8
        let hole_offset: u32 = cg.text_size;
        cg_emit32(cg, 0);

        // Register EIA_PATCH_SYM_REL32 relocation hole
        cg_add_reloc_ex(cg, hole_offset, 2, node.hash, node.hash);
        return;
    }
}

fn compile_stmt(cg: *mut CodeGen, stmt: *mut AstNode) {
    if stmt == (0 as *mut AstNode) { return; }

    if stmt.kind == 105 { // NODE_LET
        let var_hash: u64 = stmt.hash;
        let mut var_size: u32 = 8;
        let mut is_ptr: u32 = 0;
        if stmt.id == 1 { is_ptr = 1; }
        let mut is_val: u32 = 0;
        if stmt.id == 3 { is_val = 1; }
        if stmt.id == 10 || stmt.id == 11 {
            is_val = 1;
            is_ptr = stmt.id; // record 10 for byte array, 11 for pointer array
            var_size = stmt.val as u32;
        }
        let mut s_hash: u64 = 0;

        if is_val == 1 && stmt.id == 3 {
            s_hash = stmt.val;
            let si: *mut StructInfo = cg_find_struct(cg, s_hash);
            if si != (0 as *mut StructInfo) {
                var_size = si.total_size;
            } else {
                var_size = 24;
            }
        } else if is_ptr == 1 {
            s_hash = stmt.val;
            var_size = 8;
        }

        let aligned_size: u32 = ((var_size + 7) / 8) * 8;
        cg.current_stack_offset = cg.current_stack_offset + aligned_size;

        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 32)) as *mut LocalVar;
        lv.name_hash = var_hash;
        lv.rbp_offset = cg.current_stack_offset;
        lv.size = var_size;
        lv.is_struct_ptr = is_ptr;
        lv.is_struct_val = is_val;
        lv.struct_hash = s_hash;
        cg.local_count = cg.local_count + 1;

        if stmt.child1 != (0 as *mut AstNode) {
            compile_expr(cg, stmt.child1);
            // mov [rbp - rbp_offset], rax
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133);
            cg_emit32(cg, 0 - lv.rbp_offset);
        }
        return;
    }

    if stmt.kind == 106 { // NODE_ASSIGN
        let lhs: *mut AstNode = stmt.child1;
        let rhs: *mut AstNode = stmt.child2;

        if lhs.kind == 115 { // arr[idx] = rhs
            compile_expr(cg, lhs.child1); // base in rax
            cg_emit8(cg, 80);             // push rax
            compile_expr(cg, lhs.child2); // index in rax
            cg_emit8(cg, 91);             // pop rbx (base)

            let mut is_byte: u32 = 1;
            if lhs.child1.kind == 117 {
                let lv: *mut LocalVar = cg_find_local(cg, lhs.child1.hash);
                if lv != (0 as *mut LocalVar) && lv.is_struct_ptr == 11 {
                    is_byte = 0;
                }
            }

            if is_byte == 1 {
                cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 195); // add rbx, rax
                cg_emit8(cg, 83); // push rbx
                compile_expr(cg, rhs);
                cg_emit8(cg, 91); // pop rbx
                cg_emit8(cg, 136); cg_emit8(cg, 3); // mov byte ptr [rbx], al
            } else {
                cg_emit8(cg, 72); cg_emit8(cg, 193); cg_emit8(cg, 224); cg_emit8(cg, 3); // shl rax, 3
                cg_emit8(cg, 72); cg_emit8(cg, 1); cg_emit8(cg, 195); // add rbx, rax
                cg_emit8(cg, 83); // push rbx
                compile_expr(cg, rhs);
                cg_emit8(cg, 91); // pop rbx
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 3); // mov [rbx], rax
            }
            return;
        }

        if lhs.kind == 114 { // p.field = rhs
            let base: *mut AstNode = lhs.child1;
            let mut s_hash: u64 = 0;
            if base != (0 as *mut AstNode) && base.kind == 117 {
                let lv: *mut LocalVar = cg_find_local(cg, base.hash);
                if lv != (0 as *mut LocalVar) {
                    s_hash = lv.struct_hash;
                }
            }
            if s_hash == 0 && cg.struct_count > 0 {
                let first_s: *mut StructInfo = cg.structs;
                s_hash = first_s.type_sig_hash;
            }

            compile_expr(cg, base);
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 198); // mov rsi, rax

            // EIA hole: lea rdi, [rsi + 0x00000000]
            cg_emit8(cg, 72); cg_emit8(cg, 141); cg_emit8(cg, 190);
            let hole_offset: u32 = cg.text_size;
            cg_emit32(cg, 0);
            cg_add_reloc(cg, hole_offset, s_hash, lhs.hash);

            cg_emit8(cg, 87); // push rdi (target address)
            compile_expr(cg, rhs);
            cg_emit8(cg, 95); // pop rdi

            // mov [rdi], rax (48 89 07)
            cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 7);
            return;
        }

        if lhs.kind == 117 { // var = rhs
            let lv: *mut LocalVar = cg_find_local(cg, lhs.hash);
            compile_expr(cg, rhs);
            if lv != (0 as *mut LocalVar) {
                cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 133);
                cg_emit32(cg, 0 - lv.rbp_offset);
            }
            return;
        }
    }

    if stmt.kind == 107 { // NODE_IF
        compile_expr(cg, stmt.child1);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192); // test rax, rax
        cg_emit8(cg, 15); cg_emit8(cg, 132);                    // jz .Lend
        let jz_end_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);

        let mut bs: *mut AstNode = stmt.child2;
        while bs != (0 as *mut AstNode) {
            compile_stmt(cg, bs);
            bs = bs.next;
        }

        let end_offset: u32 = cg.text_size;
        cg_patch32(cg, jz_end_hole, end_offset - (jz_end_hole + 4));
        return;
    }

    if stmt.kind == 108 { // NODE_WHILE
        let loop_offset: u32 = cg.text_size;
        compile_expr(cg, stmt.child1);
        cg_emit8(cg, 72); cg_emit8(cg, 133); cg_emit8(cg, 192); // test rax, rax
        cg_emit8(cg, 15); cg_emit8(cg, 132);                    // jz .Lend
        let jz_end_hole: u32 = cg.text_size;
        cg_emit32(cg, 0);

        let mut bs: *mut AstNode = stmt.child2;
        while bs != (0 as *mut AstNode) {
            compile_stmt(cg, bs);
            bs = bs.next;
        }

        cg_emit8(cg, 233); // jmp loop_offset
        let jmp_disp: i32 = (loop_offset as i32) - ((cg.text_size + 4) as i32);
        cg_emit32(cg, jmp_disp as u32);

        let end_offset: u32 = cg.text_size;
        cg_patch32(cg, jz_end_hole, end_offset - (jz_end_hole + 4));
        return;
    }

    if stmt.kind == 109 { // NODE_RETURN
        if stmt.child1 != (0 as *mut AstNode) {
            compile_expr(cg, stmt.child1);
        } else {
            cg_emit8(cg, 49); cg_emit8(cg, 192); // xor eax, eax
        }
        // Epilogue: mov rsp, rbp; pop rbp; ret
        cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 236);
        cg_emit8(cg, 93);
        cg_emit8(cg, 195);
        return;
    }

    if stmt.kind == 110 { // NODE_EXPR_STMT
        compile_expr(cg, stmt.child1);
        return;
    }
}

fn compile_fn(cg: *mut CodeGen, fnode: *mut AstNode) {
    let fn_text_offset: u32 = cg.text_size;
    let fn_vaddr: u64 = 4259840 + (fn_text_offset as u64); // 0x410000 = 4259840

    // Prologue: push rbp; mov rbp, rsp; sub rsp, 4096
    cg_emit8(cg, 85);
    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 229);
    cg_emit8(cg, 72); cg_emit8(cg, 129); cg_emit8(cg, 236); cg_emit32(cg, 4096);

    cg.local_count = 0;
    cg.current_stack_offset = 0;

    // Save incoming parameters from registers to stack frame slots
    let mut p_idx: u32 = 0;
    let mut p_cur: *mut AstNode = fnode.child2;
    while p_cur != (0 as *mut AstNode) && p_idx < 6 {
        cg.current_stack_offset = cg.current_stack_offset + 8;
        let lv: *mut LocalVar = ((cg.locals as *mut u8) + ((cg.local_count as u64) * 32)) as *mut LocalVar;
        lv.name_hash = p_cur.hash;
        lv.rbp_offset = cg.current_stack_offset;
        lv.size = 8;
        lv.is_struct_ptr = p_cur.is_mut;
        lv.is_struct_val = 0;
        lv.struct_hash = p_cur.val;
        cg.local_count = cg.local_count + 1;

        if p_idx == 0 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 189); } // mov [rbp - disp], rdi
        else if p_idx == 1 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 181); } // rsi
        else if p_idx == 2 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 149); } // rdx
        else if p_idx == 3 { cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 141); } // rcx
        else if p_idx == 4 { cg_emit8(cg, 76); cg_emit8(cg, 137); cg_emit8(cg, 133); } // r8
        else if p_idx == 5 { cg_emit8(cg, 76); cg_emit8(cg, 137); cg_emit8(cg, 141); } // r9
        cg_emit32(cg, 0 - lv.rbp_offset);

        p_idx = p_idx + 1;
        p_cur = p_cur.next;
    }

    let mut stmt: *mut AstNode = fnode.child1;
    while stmt != (0 as *mut AstNode) {
        compile_stmt(cg, stmt);
        stmt = stmt.next;
    }

    // Epilogue default: mov rsp, rbp; pop rbp; ret
    cg_emit8(cg, 72); cg_emit8(cg, 137); cg_emit8(cg, 236);
    cg_emit8(cg, 93);
    cg_emit8(cg, 195);

    let fn_code_size: u64 = (cg.text_size - fn_text_offset) as u64;

    // Collect parameter types and ptr kinds
    let mut param_types_buf: [u64; 8];
    let mut param_ptrs_buf: [u64; 8];
    let p_types: *mut u64 = &mut param_types_buf[0];
    let p_ptrs: *mut u64 = &mut param_ptrs_buf[0];
    let mut pc: *mut AstNode = fnode.child2;
    let mut p_count: u32 = 0;
    while pc != (0 as *mut AstNode) && p_count < 8 {
        p_types[p_count as u64] = pc.val;
        p_ptrs[p_count as u64] = pc.is_mut as u64;
        p_count = p_count + 1;
        pc = pc.next;
    }
    let sig_hash: u64 = compute_canonical_sig_hash(p_count, fnode.val, p_types as *u64, p_ptrs as *u64);

    // Register SymbolContract
    let sc: *mut SymbolContract = ((cg.contracts as *mut u8) + ((cg.contract_count as u64) * 48)) as *mut SymbolContract;
    sc.symbol_hash = fnode.hash;
    sc.type_sig_hash = sig_hash;
    sc.vaddr = fn_vaddr;
    sc.code_size = fn_code_size;
    sc.flags = 1;
    sc.param_conv = p_idx;
    sc.contract_digest = sig_hash;
    cg.contract_count = cg.contract_count + 1;

    // Patch call main hole in _start
    if cg.call_main_hole != 0 {
        let disp: i32 = (fn_text_offset as i32) - ((cg.call_main_hole + 4) as i32);
        cg_patch32(cg, cg.call_main_hole, disp as u32);
    }
}

// -------------------------------------------------------------------------
//             9. Calling Convention Bridge & Widening Stencils
// -------------------------------------------------------------------------

struct CallingConventionBridge {
    from_conv: u32,
    to_conv: u32,
    thunk_size: u32,
    thunk_bytes: [u8; 64],
}

fn arll_negotiate_calling_convention(bridge: *mut CallingConventionBridge, from_conv: u32, to_conv: u32) -> u32 {
    bridge.from_conv = from_conv;
    bridge.to_conv = to_conv;

    if from_conv == 1 && to_conv == 2 {
        let b: *mut u8 = &mut bridge.thunk_bytes[0];
        b[0] = 73;  b[1] = 137; b[2] = 201; // mov r9, rcx
        b[3] = 73;  b[4] = 137; b[5] = 208; // mov r8, rdx
        b[6] = 72;  b[7] = 137; b[8] = 242; // mov rdx, rsi
        b[9] = 72;  b[10] = 137; b[11] = 249; // mov rcx, rdi
        b[12] = 72; b[13] = 131; b[14] = 236; b[15] = 40; // sub rsp, 40
        b[16] = 255; b[17] = 208;           // call rax
        b[18] = 72; b[19] = 131; b[20] = 196; b[21] = 40; // add rsp, 40
        b[22] = 195;                        // ret
        bridge.thunk_size = 23;
        return 23;
    }

    if from_conv == 2 && to_conv == 1 {
        let b: *mut u8 = &mut bridge.thunk_bytes[0];
        b[0] = 72; b[1] = 137; b[2] = 207; // mov rdi, rcx
        b[3] = 72; b[4] = 137; b[5] = 214; // mov rsi, rdx
        b[6] = 76; b[7] = 137; b[8] = 194; // mov rdx, r8
        b[9] = 76; b[10] = 137; b[11] = 201; // mov rcx, r9
        b[12] = 255; b[13] = 208;          // call rax
        b[14] = 195;                       // ret
        bridge.thunk_size = 15;
        return 15;
    }

    bridge.thunk_size = 0;
    return 0;
}

struct SchemaEvolutionStencil {
    old_size: u32,
    new_size: u32,
    is_signed: u32,
    stencil_size: u32,
    stencil_bytes: [u8; 32],
}

fn arll_emit_widening_stencil(stencil: *mut SchemaEvolutionStencil, old_size: u32, new_size: u32, is_signed: u32) -> u32 {
    stencil.old_size = old_size;
    stencil.new_size = new_size;
    stencil.is_signed = is_signed;

    let b: *mut u8 = &mut stencil.stencil_bytes[0];
    if old_size == 4 && new_size == 8 {
        if is_signed == 0 {
            b[0] = 139; b[1] = 7; // mov eax, [rdi]
            b[2] = 195;           // ret
            stencil.stencil_size = 3;
            return 3;
        } else {
            b[0] = 72; b[1] = 99; b[2] = 7; // movsxd rax, [rdi]
            b[3] = 195;                     // ret
            stencil.stencil_size = 4;
            return 4;
        }
    }

    if old_size == 1 && new_size == 8 {
        if is_signed == 0 {
            b[0] = 72; b[1] = 15; b[2] = 182; b[3] = 7; // movzx rax, byte ptr [rdi]
            b[4] = 195;                                 // ret
            stencil.stencil_size = 5;
            return 5;
        } else {
            b[0] = 72; b[1] = 15; b[2] = 190; b[3] = 7; // movsx rax, byte ptr [rdi]
            b[4] = 195;                                 // ret
            stencil.stencil_size = 5;
            return 5;
        }
    }

    b[0] = 72; b[1] = 139; b[2] = 7; // mov rax, [rdi]
    b[3] = 195;                      // ret
    stencil.stencil_size = 4;
    return 4;
}

// -------------------------------------------------------------------------
//                10. Cryptographic Hashing Engine (BLAKE3-64)
// -------------------------------------------------------------------------

fn rotr32(x: u32, n: u32) -> u32 {
    let x32: u32 = x & 4294967295;
    let r: u32 = x32 >> n;
    let l: u32 = (x32 << (32 - n)) & 4294967295;
    return (r | l) & 4294967295;
}

fn get_u32(buf: *u8, idx: u64) -> u32 {
    let p: *u8 = buf + (idx * 4);
    let b0: u32 = p[0] as u32;
    let b1: u32 = p[1] as u32;
    let b2: u32 = p[2] as u32;
    let b3: u32 = p[3] as u32;
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 4294967295;
}

fn set_u32(buf: *mut u8, idx: u64, val: u32) {
    let p: *mut u8 = buf + (idx * 4);
    p[0] = (val & 255) as u8;
    p[1] = ((val >> 8) & 255) as u8;
    p[2] = ((val >> 16) & 255) as u8;
    p[3] = ((val >> 24) & 255) as u8;
}

fn blake3_round_g(state: *mut u8, msg: *u8, step: u64) {
    let mut a_idx: u64 = 0;
    let mut b_idx: u64 = 0;
    let mut c_idx: u64 = 0;
    let mut d_idx: u64 = 0;
    let mx_idx: u64 = step * 2;
    let my_idx: u64 = (step * 2) + 1;

    if step == 0 { a_idx = 0; b_idx = 4; c_idx = 8;  d_idx = 12; }
    else if step == 1 { a_idx = 1; b_idx = 5; c_idx = 9;  d_idx = 13; }
    else if step == 2 { a_idx = 2; b_idx = 6; c_idx = 10; d_idx = 14; }
    else if step == 3 { a_idx = 3; b_idx = 7; c_idx = 11; d_idx = 15; }
    else if step == 4 { a_idx = 0; b_idx = 5; c_idx = 10; d_idx = 15; }
    else if step == 5 { a_idx = 1; b_idx = 6; c_idx = 11; d_idx = 12; }
    else if step == 6 { a_idx = 2; b_idx = 7; c_idx = 8;  d_idx = 13; }
    else if step == 7 { a_idx = 3; b_idx = 4; c_idx = 9;  d_idx = 14; }

    let mx: u32 = get_u32(msg, mx_idx);
    let my: u32 = get_u32(msg, my_idx);

    let mut a: u32 = get_u32(state, a_idx);
    let mut b: u32 = get_u32(state, b_idx);
    let mut c: u32 = get_u32(state, c_idx);
    let mut d: u32 = get_u32(state, d_idx);

    a = (a + b + mx) & 4294967295;
    d = rotr32(d ^ a, 16);
    c = (c + d) & 4294967295;
    b = rotr32(b ^ c, 12);
    a = (a + b + my) & 4294967295;
    d = rotr32(d ^ a, 8);
    c = (c + d) & 4294967295;
    b = rotr32(b ^ c, 7);

    set_u32(state, a_idx, a);
    set_u32(state, b_idx, b);
    set_u32(state, c_idx, c);
    set_u32(state, d_idx, d);
}

fn blake3_permute_msg(msg: *mut u8) {
    let mut temp: [u8; 64];
    let t: *mut u8 = &mut temp[0];
    let mut i: u64 = 0;
    while i < 16 {
        set_u32(t, i, get_u32(msg, i));
        i = i + 1;
    }
    set_u32(msg, 0,  get_u32(t, 2));
    set_u32(msg, 1,  get_u32(t, 6));
    set_u32(msg, 2,  get_u32(t, 3));
    set_u32(msg, 3,  get_u32(t, 10));
    set_u32(msg, 4,  get_u32(t, 7));
    set_u32(msg, 5,  get_u32(t, 0));
    set_u32(msg, 6,  get_u32(t, 4));
    set_u32(msg, 7,  get_u32(t, 13));
    set_u32(msg, 8,  get_u32(t, 1));
    set_u32(msg, 9,  get_u32(t, 11));
    set_u32(msg, 10, get_u32(t, 12));
    set_u32(msg, 11, get_u32(t, 5));
    set_u32(msg, 12, get_u32(t, 9));
    set_u32(msg, 13, get_u32(t, 14));
    set_u32(msg, 14, get_u32(t, 15));
    set_u32(msg, 15, get_u32(t, 8));
}

fn blake3_compress_64(cv: *mut u8, block_buf: *u8, block_len: u32, block_index: u64, flags: u32) -> u64 {
    let mut state_buf: [u8; 64];
    let state: *mut u8 = &mut state_buf[0];

    let mut i: u64 = 0;
    while i < 8 {
        set_u32(state, i, get_u32(cv, i));
        i = i + 1;
    }
    set_u32(state, 8,  1779033703);
    set_u32(state, 9,  3144134277);
    set_u32(state, 10, 1013904242);
    set_u32(state, 11, 2773480762);
    set_u32(state, 12, (block_index & 4294967295) as u32);
    set_u32(state, 13, ((block_index >> 32) & 4294967295) as u32);
    set_u32(state, 14, block_len);
    set_u32(state, 15, flags);

    let mut msg_buf: [u8; 64];
    let msg: *mut u8 = &mut msg_buf[0];
    i = 0;
    while i < 64 {
        if i < (block_len as u64) {
            msg[i] = block_buf[i];
        } else {
            msg[i] = 0;
        }
        i = i + 1;
    }

    let mut round: u64 = 0;
    while round < 7 {
        let mut step: u64 = 0;
        while step < 8 {
            blake3_round_g(state, msg, step);
            step = step + 1;
        }
        if round < 6 {
            blake3_permute_msg(msg);
        }
        round = round + 1;
    }

    i = 0;
    while i < 8 {
        let new_cv_word: u32 = get_u32(state, i) ^ get_u32(state, i + 8);
        set_u32(cv, i, new_cv_word);
        i = i + 1;
    }

    let low: u64 = (get_u32(cv, 0) as u64) & 4294967295;
    let high: u64 = (get_u32(cv, 1) as u64) & 4294967295;
    return low | (high << 32);
}

fn blake3_init_cv(cv: *mut u8) {
    set_u32(cv, 0, 1779033703);
    set_u32(cv, 1, 3144134277);
    set_u32(cv, 2, 1013904242);
    set_u32(cv, 3, 2773480762);
    set_u32(cv, 4, 1359893119);
    set_u32(cv, 5, 2600822924);
    set_u32(cv, 6, 528734635);
    set_u32(cv, 7, 1541459225);
}

fn blake3_hash_chunk(chunk_data: *u8, chunk_len: u64, chunk_counter: u64, is_root: u32, out_cv: *mut u8) {
    blake3_init_cv(out_cv);
    if chunk_len == 0 {
        let mut flags: u32 = 1 | 2; // CHUNK_START | CHUNK_END
        if is_root == 1 { flags = flags | 8; }
        blake3_compress_64(out_cv, chunk_data, 0, chunk_counter, flags);
        return;
    }
    let num_blocks: u64 = (chunk_len + 63) / 64;
    let mut b: u64 = 0;
    let mut blk_off: u64 = 0;
    while b < num_blocks {
        let mut blk_len: u32 = 64;
        if (chunk_len - blk_off) < 64 {
            blk_len = (chunk_len - blk_off) as u32;
        }
        let mut flags: u32 = 0;
        if b == 0 { flags = flags | 1; } // CHUNK_START
        if b == (num_blocks - 1) {
            flags = flags | 2; // CHUNK_END
            if is_root == 1 { flags = flags | 8; }
        }
        blake3_compress_64(out_cv, chunk_data + blk_off, blk_len, chunk_counter, flags);
        blk_off = blk_off + (blk_len as u64);
        b = b + 1;
    }
}

fn blake3_parent_cv(left_cv: *u8, right_cv: *u8, is_root: u32, out_cv: *mut u8) {
    let mut block_buf: [u8; 64];
    let block: *mut u8 = &mut block_buf[0];
    let mut i: u64 = 0;
    while i < 32 {
        block[i] = left_cv[i];
        block[i + 32] = right_cv[i];
        i = i + 1;
    }
    blake3_init_cv(out_cv);
    let mut flags: u32 = 4; // PARENT
    if is_root == 1 { flags = flags | 8; }
    blake3_compress_64(out_cv, block, 64, 0, flags);
}

fn blake3_hash64(buf: *u8, len: u64) -> u64 {
    let mut root_cv_buf: [u8; 32];
    let root_cv: *mut u8 = &mut root_cv_buf[0];

    if len <= 1024 {
        blake3_hash_chunk(buf, len, 0, 1, root_cv);
        let low: u64 = (get_u32(root_cv, 0) as u64) & 4294967295;
        let high: u64 = (get_u32(root_cv, 1) as u64) & 4294967295;
        return low | (high << 32);
    }

    let num_chunks: u64 = (len + 1023) / 1024;
    let mut stack_cv_buf: [u8; 2048];
    let mut cv_list: *mut u8 = &mut stack_cv_buf[0];
    let mut is_allocated: u32 = 0;
    let cv_bytes: u64 = ((num_chunks * 32) + 4095) & ~4095;
    if num_chunks > 64 {
        if num_chunks > 1048576 { return 0; }
        let ptr: *mut u8 = syscall(9, 0, cv_bytes, 3, 34, -1, 0) as *mut u8;
        if (ptr as i64) > 0 {
            cv_list = ptr;
            is_allocated = 1;
        } else {
            return 0;
        }
    }

    let mut c: u64 = 0;
    while c < num_chunks {
        let c_off: u64 = c * 1024;
        let mut c_len: u64 = 1024;
        if (len - c_off) < 1024 {
            c_len = len - c_off;
        }
        blake3_hash_chunk(buf + c_off, c_len, c, 0, cv_list + (c * 32));
        c = c + 1;
    }

    let mut cv_count: u64 = num_chunks;

    while cv_count > 1 {
        let mut next_count: u64 = 0;
        let mut idx: u64 = 0;
        while idx < cv_count {
            if (idx + 1) < cv_count {
                let mut is_root: u32 = 0;
                if cv_count == 2 { is_root = 1; }
                let mut p_cv_buf: [u8; 32];
                let p_cv: *mut u8 = &mut p_cv_buf[0];
                blake3_parent_cv(cv_list + (idx * 32), cv_list + ((idx + 1) * 32), is_root, p_cv);
                let mut k: u64 = 0;
                while k < 32 {
                    cv_list[(next_count * 32) + k] = p_cv[k];
                    k = k + 1;
                }
                next_count = next_count + 1;
            } else {
                let mut k: u64 = 0;
                while k < 32 {
                    cv_list[(next_count * 32) + k] = cv_list[(idx * 32) + k];
                    k = k + 1;
                }
                next_count = next_count + 1;
            }
            idx = idx + 2;
        }
        cv_count = next_count;
    }

    let low: u64 = (get_u32(cv_list, 0) as u64) & 4294967295;
    let high: u64 = (get_u32(cv_list, 1) as u64) & 4294967295;
    if is_allocated == 1 {
        syscall(11, cv_list, cv_bytes); // SYS_munmap
    }
    return low | (high << 32);
}

fn compute_canonical_sig_hash(param_cnt: u32, ret_type_hash: u64, param_types: *u64, param_ptrs: *u64) -> u64 {
    let mut sig_buf: [u8; 144];
    let p: *mut u8 = &mut sig_buf[0];
    let mut i: u64 = 0;
    while i < 144 {
        p[i] = 0;
        i = i + 1;
    }

    // Bytes 0..3: param_cnt
    p[0] = (param_cnt & 255) as u8;
    p[1] = ((param_cnt >> 8) & 255) as u8;
    p[2] = ((param_cnt >> 16) & 255) as u8;
    p[3] = ((param_cnt >> 24) & 255) as u8;

    // Bytes 4..7: calling_conv (0)
    p[4] = 0; p[5] = 0; p[6] = 0; p[7] = 0;

    // Bytes 8..15: ret_type_hash
    let mut rh: u64 = ret_type_hash;
    let mut b: u64 = 0;
    while b < 8 {
        p[8 + b] = (rh & 255) as u8;
        rh = rh >> 8;
        b = b + 1;
    }

    // Bytes 16 + i*16 .. : params
    let mut pi: u32 = 0;
    while pi < param_cnt && pi < 8 {
        let base: u64 = 16 + ((pi as u64) * 16);
        let mut th: u64 = param_types[pi as u64];
        let mut ptr_kind: u64 = param_ptrs[pi as u64];
        b = 0;
        while b < 8 {
            p[base + b] = (th & 255) as u8;
            th = th >> 8;
            b = b + 1;
        }
        b = 0;
        while b < 8 {
            p[base + 8 + b] = (ptr_kind & 255) as u8;
            ptr_kind = ptr_kind >> 8;
            b = b + 1;
        }
        pi = pi + 1;
    }

    let total_len: u64 = 16 + ((param_cnt as u64) * 16);
    return blake3_hash64(p, total_len);
}

// -------------------------------------------------------------------------
//                11. UPBP Polyglot Binary Package Writer
// -------------------------------------------------------------------------

fn write_elf64_binary(cg: *mut CodeGen, out_path: *u8, is_upbp: u32) -> i64 {
    let mut holo_offset: u64 = 1152; // 0x480 for UPBP
    let mut contracts_offset: u64 = 1248; // 0x480 + 96 = 0x4E0 for UPBP
    if is_upbp == 0 {
        holo_offset = 128; // 0x80 for Native ELF
        contracts_offset = 224; // 0xE0 for Native ELF
    }
    let contracts_size: u64 = (cg.contract_count as u64) * 48;

    let relocs_offset: u64 = contracts_offset + contracts_size;
    let relocs_size: u64 = (cg.reloc_count as u64) * 24;

    let tg_offset: u64 = relocs_offset + relocs_size;
    let tg_size: u64 = (cg.tg_count as u64) * 24;

    let text_offset: u64 = 65536; // 0x10000
    let rodata_offset: u64 = 196608; // 0x30000
    let total_file_size: u64 = rodata_offset + 4096;

    let file_buf: *mut u8 = mmap_alloc(total_file_size);
    if (file_buf as i64) < 0 {
        return -1;
    }

    let mut z: u64 = 0;
    while z < total_file_size {
        file_buf[z] = 0;
        z = z + 1;
    }

    let mut emach: u8 = 62; // EM_X86_64
    if cg.target_arch == 1 {
        emach = 183; // EM_AARCH64 (0xB7)
    } else if cg.target_arch == 2 {
        emach = 243; // EM_RISCV (0xF3)
    }

    if is_upbp == 1 {
        // 1. Offset 0x000: DOS MZ Header Stub (0x4D 0x5A)
        // Compatible with Windows loader and POSIX shell variable assignment
        file_buf[0] = 77; // 'M'
        file_buf[1] = 90; // 'Z'
        file_buf[2] = 61; // '='
        file_buf[3] = 59; // ';'
        file_buf[4] = 10; // '\n'
        file_buf[5] = 35; // '#'
        file_buf[6] = 33; // '!'
        file_buf[7] = 47; // '/'
        file_buf[8] = 98; // 'b'
        file_buf[9] = 105; // 'i'
        file_buf[10] = 110; // 'n'
        file_buf[11] = 47;  // '/'
        file_buf[12] = 115; // 's'
        file_buf[13] = 104; // 'h'
        file_buf[14] = 10;  // '\n'

        // bytes 15-49: shell trampoline with exit 42
        let tramp1: *u8 = "tail -c+129 \"$0\">z 2>/dev/null;exit 42\n";
        let mut ti: u64 = 0;
        while ti < 39 {
            file_buf[15 + ti] = tramp1[ti];
            ti = ti + 1;
        }
        while ti < 45 {
            file_buf[15 + ti] = 32;
            ti = ti + 1;
        }

        // bytes 60-63: e_lfanew = 0x140
        file_buf[60] = 64;  // 0x40
        file_buf[61] = 1;   // 0x01 -> 0x00000140
        file_buf[62] = 0;
        file_buf[63] = 0;

        // bytes 64-127: POSIX Shell Trampoline pattern data
        file_buf[64] = 35;  // '#'
        file_buf[65] = 33;  // '!'
        file_buf[66] = 47;  // '/'
        file_buf[67] = 98;  // 'b'
        file_buf[68] = 105; // 'i'
        file_buf[69] = 110; // 'n'
        file_buf[70] = 47;  // '/'
        file_buf[71] = 115; // 's'
        file_buf[72] = 104; // 'h'
        file_buf[73] = 10;  // '\n'
        file_buf[74] = 32; file_buf[75] = 32; file_buf[76] = 32; file_buf[77] = 32;
        file_buf[78] = 32; file_buf[79] = 32; file_buf[80] = 32; file_buf[81] = 32;
        // "tail" at byte 82
        file_buf[82] = 116; file_buf[83] = 97; file_buf[84] = 105; file_buf[85] = 108;
        file_buf[86] = 32; file_buf[87] = 45; file_buf[88] = 99; file_buf[89] = 43;
        file_buf[90] = 49; file_buf[91] = 50; file_buf[92] = 57; file_buf[93] = 32;
        file_buf[94] = 34; file_buf[95] = 36; file_buf[96] = 48; file_buf[97] = 34;
        file_buf[98] = 62; file_buf[99] = 122; file_buf[100] = 59; file_buf[101] = 99;
        file_buf[102] = 104; file_buf[103] = 109; file_buf[104] = 111; file_buf[105] = 100;
        file_buf[106] = 32; file_buf[107] = 43; file_buf[108] = 120; file_buf[109] = 32;
        file_buf[110] = 122; file_buf[111] = 59;
        file_buf[112] = 32; file_buf[113] = 32; file_buf[114] = 32;
        // "exec" at byte 115
        file_buf[115] = 101; file_buf[116] = 120; file_buf[117] = 101; file_buf[118] = 99;
        file_buf[119] = 32; file_buf[120] = 47; file_buf[121] = 98; file_buf[122] = 105;
        file_buf[123] = 110; file_buf[124] = 47; file_buf[125] = 115; file_buf[126] = 104;
        file_buf[127] = 10;

        let elf_base: u64 = 128; // 0x80
        file_buf[elf_base + 0] = 127; // 0x7F
        file_buf[elf_base + 1] = 69;  // 'E'
        file_buf[elf_base + 2] = 76;  // 'L'
        file_buf[elf_base + 3] = 70;  // 'F'
        file_buf[elf_base + 4] = 2;   // ELFCLASS64
        file_buf[elf_base + 5] = 1;   // ELFDATA2LSB
        file_buf[elf_base + 6] = 1;   // EV_CURRENT
        file_buf[elf_base + 7] = 0;   // ELFOSABI_NONE

        file_buf[elf_base + 16] = 2; file_buf[elf_base + 17] = 0;
        file_buf[elf_base + 18] = emach; file_buf[elf_base + 19] = 0;
        file_buf[elf_base + 20] = 1;
        file_buf[elf_base + 24] = 0; file_buf[elf_base + 25] = 0; file_buf[elf_base + 26] = 65; file_buf[elf_base + 27] = 0;

        file_buf[elf_base + 32] = 64;
        file_buf[elf_base + 52] = 64;
        file_buf[elf_base + 54] = 56;
        file_buf[elf_base + 56] = 1;
        file_buf[elf_base + 58] = 64;

        // ELF64 Program Header (56 bytes at elf_base + 64)
        let ph_base: u64 = elf_base + 64;
        file_buf[ph_base + 0] = 1; // p_type = 1 (PT_LOAD)
        file_buf[ph_base + 4] = 5; // p_flags = 5 (PF_R | PF_X - strict W^X)
        file_buf[ph_base + 16] = 0; file_buf[ph_base + 17] = 0; file_buf[ph_base + 18] = 64; file_buf[ph_base + 19] = 0;
        file_buf[ph_base + 24] = 0; file_buf[ph_base + 25] = 0; file_buf[ph_base + 26] = 64; file_buf[ph_base + 27] = 0;
        file_buf[ph_base + 32] = (total_file_size & 255) as u8;
        file_buf[ph_base + 33] = ((total_file_size >> 8) & 255) as u8;
        file_buf[ph_base + 34] = ((total_file_size >> 16) & 255) as u8;
        let mut memsz: u64 = total_file_size;
        if cg.target_arch == 0 {
            memsz = total_file_size + 1048576;
        }
        file_buf[ph_base + 40] = (memsz & 255) as u8;
        file_buf[ph_base + 41] = ((memsz >> 8) & 255) as u8;
        file_buf[ph_base + 42] = ((memsz >> 16) & 255) as u8;
        file_buf[ph_base + 48] = 0; file_buf[ph_base + 49] = 16;

        // 4. Offset 0x140: PE/COFF Headers (PE\0\0)
        let pe_base: u64 = 320; // 0x140
        file_buf[pe_base + 0] = 80; file_buf[pe_base + 1] = 69; file_buf[pe_base + 2] = 0; file_buf[pe_base + 3] = 0;
        file_buf[pe_base + 4] = 100; file_buf[pe_base + 5] = 134;
        file_buf[pe_base + 6] = 1;   file_buf[pe_base + 7] = 0;
        file_buf[pe_base + 20] = 240; file_buf[pe_base + 21] = 0;
        file_buf[pe_base + 22] = 34;  file_buf[pe_base + 23] = 0;

        // Optional Header (PE32+ 64-bit at pe_base + 24)
        let opt_base: u64 = pe_base + 24;
        file_buf[opt_base + 0] = 11; file_buf[opt_base + 1] = 2;
        file_buf[opt_base + 2] = 1;  file_buf[opt_base + 3] = 0;
        file_buf[opt_base + 16] = 0; file_buf[opt_base + 17] = 0; file_buf[opt_base + 18] = 1;
        file_buf[opt_base + 20] = 0; file_buf[opt_base + 21] = 0; file_buf[opt_base + 22] = 1;
        file_buf[opt_base + 24] = 0; file_buf[opt_base + 25] = 0; file_buf[opt_base + 26] = 0; file_buf[opt_base + 27] = 64; file_buf[opt_base + 28] = 1;
        file_buf[opt_base + 32] = 0; file_buf[opt_base + 33] = 16;
        file_buf[opt_base + 36] = 0; file_buf[opt_base + 37] = 2;
        file_buf[opt_base + 68] = 3; file_buf[opt_base + 69] = 0;

        // 5. Offset 0x200: Mach-O 64-bit Load Commands (0xFEEDFACF)
        let macho_base: u64 = 512; // 0x200
        file_buf[macho_base + 0] = 207; file_buf[macho_base + 1] = 250; file_buf[macho_base + 2] = 237; file_buf[macho_base + 3] = 254;
        file_buf[macho_base + 4] = 7;   file_buf[macho_base + 5] = 0;   file_buf[macho_base + 6] = 0;   file_buf[macho_base + 7] = 1;
        file_buf[macho_base + 8] = 3;   file_buf[macho_base + 9] = 0;   file_buf[macho_base + 10] = 0;  file_buf[macho_base + 11] = 128;
        file_buf[macho_base + 12] = 2;  file_buf[macho_base + 13] = 0;
        file_buf[macho_base + 16] = 1;  file_buf[macho_base + 17] = 0;
        file_buf[macho_base + 20] = 72; file_buf[macho_base + 21] = 0;
        file_buf[macho_base + 24] = 133; file_buf[macho_base + 25] = 0; file_buf[macho_base + 26] = 32; file_buf[macho_base + 27] = 0;

        let seg_base: u64 = macho_base + 32;
        file_buf[seg_base + 0] = 25;
        file_buf[seg_base + 4] = 72;
        file_buf[seg_base + 8] = 95; file_buf[seg_base + 9] = 95; file_buf[seg_base + 10] = 84; file_buf[seg_base + 11] = 69; file_buf[seg_base + 12] = 88; file_buf[seg_base + 13] = 84;
        file_buf[seg_base + 32] = 0; file_buf[seg_base + 33] = 0; file_buf[seg_base + 34] = 0; file_buf[seg_base + 35] = 0; file_buf[seg_base + 36] = 1;
        file_buf[seg_base + 40] = 0; file_buf[seg_base + 41] = 0; file_buf[seg_base + 42] = 4;
        file_buf[seg_base + 56] = 7;
        file_buf[seg_base + 60] = 7;
    } else {
        // Native ELF64 at offset 0
        file_buf[0] = 127; file_buf[1] = 69; file_buf[2] = 76; file_buf[3] = 70; // \x7fELF
        file_buf[4] = 2; file_buf[5] = 1; file_buf[6] = 1; file_buf[7] = 0;
        file_buf[16] = 2; file_buf[18] = emach; file_buf[20] = 1;
        file_buf[24] = 0; file_buf[25] = 0; file_buf[26] = 65; file_buf[27] = 0; // e_entry = 0x410000
        file_buf[32] = 64; // e_phoff = 64
        file_buf[52] = 64; // e_ehsize = 64
        file_buf[54] = 56; // e_phentsize = 56
        file_buf[56] = 1;  // e_phnum = 1
        file_buf[58] = 64; // e_shentsize = 64

        let ph_base: u64 = 64;
        file_buf[ph_base + 0] = 1; // p_type = 1 (PT_LOAD)
        file_buf[ph_base + 4] = 5; // p_flags = 5 (PF_R | PF_X - strict W^X)
        file_buf[ph_base + 16] = 0; file_buf[ph_base + 17] = 0; file_buf[ph_base + 18] = 64; file_buf[ph_base + 19] = 0; // 0x400000
        file_buf[ph_base + 24] = 0; file_buf[ph_base + 25] = 0; file_buf[ph_base + 26] = 64; file_buf[ph_base + 27] = 0;
        file_buf[ph_base + 32] = (total_file_size & 255) as u8;
        file_buf[ph_base + 33] = ((total_file_size >> 8) & 255) as u8;
        file_buf[ph_base + 34] = ((total_file_size >> 16) & 255) as u8;
        let mut memsz: u64 = total_file_size;
        if cg.target_arch == 0 {
            memsz = total_file_size + 1048576;
        }
        file_buf[ph_base + 40] = (memsz & 255) as u8;
        file_buf[ph_base + 41] = ((memsz >> 8) & 255) as u8;
        file_buf[ph_base + 42] = ((memsz >> 16) & 255) as u8;
        file_buf[ph_base + 48] = 0; file_buf[ph_base + 49] = 16; // align 0x1000
    }

    // 6. Universal Hologram Header (96 bytes at offset holo_offset)
    let holo: *mut UniversalHologramHeader = (file_buf + holo_offset) as *mut UniversalHologramHeader;
    holo.magic = 1145588037; // 0x44484945 'EIAH'
    holo.version = 2;        // major 2, minor 0
    holo.abi_epoch = 1;
    holo.contracts_offset = contracts_offset;
    holo.contracts_count = cg.contract_count as u64;
    holo.relocs_offset = relocs_offset;
    holo.relocs_count = cg.reloc_count as u64;
    holo.type_graph_offset = tg_offset;
    holo.type_graph_size = tg_size;
    holo.flags = 1;
    if cg.force_bridge == 1 {
        holo.flags = holo.flags | 4; // EIA_FLAG_CALLING_CONV_BRIDGE (bit 2)
    }

    // 7. Copy SymbolContracts
    let mut i: u64 = 0;
    let sc_src: *u8 = cg.contracts as *u8;
    while i < contracts_size {
        file_buf[contracts_offset + i] = sc_src[i];
        i = i + 1;
    }

    // 8. Copy Relocation Holes
    i = 0;
    let rel_src: *u8 = cg.relocs as *u8;
    while i < relocs_size {
        file_buf[relocs_offset + i] = rel_src[i];
        i = i + 1;
    }

    // 9. Copy Type Graph
    i = 0;
    let tg_src: *u8 = cg.type_graph as *u8;
    while i < tg_size {
        file_buf[tg_offset + i] = tg_src[i];
        i = i + 1;
    }

    // Compute dynamic BLAKE3-64 root hash over contracts, relocs, and type graph tables
    let tables_len: u64 = contracts_size + relocs_size + tg_size;
    holo.blake3_root = blake3_hash64(file_buf + contracts_offset, tables_len);

    // 10. Copy .text
    i = 0;
    while i < (cg.text_size as u64) {
        file_buf[text_offset + i] = cg.text_buf[i];
        i = i + 1;
    }

    // 10b. Emit calling-convention bridge thunk if --arll-force-bridge
    if cg.force_bridge == 1 {
        let bt_offset: u64 = cg.text_size as u64;
        let bt0: u64 = 0x49; let bt1: u64 = 0x89; let bt2: u64 = 0xc9; let bt3: u64 = 0x49;
        let bt4: u64 = 0x89; let bt5: u64 = 0xd0; let bt6: u64 = 0x48; let bt7: u64 = 0x89;
        let bt8: u64 = 0xf2; let bt9: u64 = 0x48; let bt10: u64 = 0x89; let bt11: u64 = 0xf9;
        let bt12: u64 = 0x48; let bt13: u64 = 0x83; let bt14: u64 = 0xec; let bt15: u64 = 0x28;
        let bt16: u64 = 0xff; let bt17: u64 = 0xd0; let bt18: u64 = 0x48; let bt19: u64 = 0x83;
        let bt20: u64 = 0xc4; let bt21: u64 = 0x28; let bt22: u64 = 0xc3; let bt23: u64 = 0x90;
        file_buf[text_offset + bt_offset + 0] = bt0; file_buf[text_offset + bt_offset + 1] = bt1;
        file_buf[text_offset + bt_offset + 2] = bt2; file_buf[text_offset + bt_offset + 3] = bt3;
        file_buf[text_offset + bt_offset + 4] = bt4; file_buf[text_offset + bt_offset + 5] = bt5;
        file_buf[text_offset + bt_offset + 6] = bt6; file_buf[text_offset + bt_offset + 7] = bt7;
        file_buf[text_offset + bt_offset + 8] = bt8; file_buf[text_offset + bt_offset + 9] = bt9;
        file_buf[text_offset + bt_offset + 10] = bt10; file_buf[text_offset + bt_offset + 11] = bt11;
        file_buf[text_offset + bt_offset + 12] = bt12; file_buf[text_offset + bt_offset + 13] = bt13;
        file_buf[text_offset + bt_offset + 14] = bt14; file_buf[text_offset + bt_offset + 15] = bt15;
        file_buf[text_offset + bt_offset + 16] = bt16; file_buf[text_offset + bt_offset + 17] = bt17;
        file_buf[text_offset + bt_offset + 18] = bt18; file_buf[text_offset + bt_offset + 19] = bt19;
        file_buf[text_offset + bt_offset + 20] = bt20; file_buf[text_offset + bt_offset + 21] = bt21;
        file_buf[text_offset + bt_offset + 22] = bt22; file_buf[text_offset + bt_offset + 23] = bt23;
        // Update SymbolContract[0]: vaddr = TEXT_VADDR + bt_offset, code_size = 24, flags |= 4
        if cg.contract_count > 0 {
            let sc0_file_off: u64 = contracts_offset;
            let bt_vaddr: u64 = 0x410000 + bt_offset;
            file_buf[sc0_file_off + 16] = (bt_vaddr & 255) as u8;
            file_buf[sc0_file_off + 17] = ((bt_vaddr >> 8) & 255) as u8;
            file_buf[sc0_file_off + 18] = ((bt_vaddr >> 16) & 255) as u8;
            file_buf[sc0_file_off + 19] = ((bt_vaddr >> 24) & 255) as u8;
            file_buf[sc0_file_off + 20] = ((bt_vaddr >> 32) & 255) as u8;
            file_buf[sc0_file_off + 21] = ((bt_vaddr >> 40) & 255) as u8;
            file_buf[sc0_file_off + 22] = ((bt_vaddr >> 48) & 255) as u8;
            file_buf[sc0_file_off + 23] = ((bt_vaddr >> 56) & 255) as u8;
            file_buf[sc0_file_off + 24] = 24;
            file_buf[sc0_file_off + 25] = 0; file_buf[sc0_file_off + 26] = 0; file_buf[sc0_file_off + 27] = 0;
            file_buf[sc0_file_off + 32] = file_buf[sc0_file_off + 32] | 4;
        }
    }

    // 11. Copy .rodata
    i = 0;
    while i < (cg.rodata_size as u64) {
        file_buf[rodata_offset + i] = cg.rodata_buf[i];
        i = i + 1;
    }

    // 12. Write executable binary to disk
    // SYS_open = 2: path, flags=O_CREAT|O_WRONLY|O_TRUNC (577), mode=0755 (493)
    let fd: i64 = syscall(2, out_path, 577, 493);
    if fd < 0 {
        return -2;
    }

    syscall(1, fd, file_buf, total_file_size); // SYS_write
    syscall(3, fd);                            // SYS_close
    return 0;
}

// -------------------------------------------------------------------------
//                         10. Main Stage-1 Sovereign Compiler Driver
// -------------------------------------------------------------------------

fn main(argc: u64, argv: *mut *mut u8) -> i64 {
    // 1. Initialize Arenas (16MB each)
    let mut parse_arena: Arena;
    arena_init(&mut parse_arena, 16777216);

    let mut cg_arena: Arena;
    arena_init(&mut cg_arena, 16777216);

    // 2. Parse Command Line Arguments
    let mut in_path: *u8 = "tests/hello_eia.rx";
    let mut out_path: *u8 = "bin/hello_from_core1";
    let mut permute_seed: u64 = 0;
    let mut force_bridge: u32 = 0;
    let mut is_upbp: u32 = 0;
    let mut target_arch: u64 = 0;

    let mut arg_i: u64 = 1;
    while arg_i < argc {
        let arg: *u8 = argv[arg_i];
        if arg[0] == 45 && arg[1] == 111 && arg[2] == 0 { // "-o"
            arg_i = arg_i + 1;
            if arg_i < argc {
                out_path = argv[arg_i];
            }
        } else if arg[0] == 45 && arg[1] == 45 { // starts with "--"
            let seed_prefix: *u8 = "--eia-permute-seed=";
            let mut is_seed: u32 = 1;
            let mut si: u64 = 0;
            while si < 19 {
                if arg[si] != seed_prefix[si] {
                    is_seed = 0;
                }
                si = si + 1;
            }
            if is_seed == 1 {
                let val_ptr: *u8 = arg + 19;
                let mut v: u64 = 0;
                let mut vi: u64 = 0;
                if val_ptr[0] == 48 && (val_ptr[1] == 120 || val_ptr[1] == 88) { // "0x"
                    vi = 2;
                    while val_ptr[vi] != 0 {
                        let c: u8 = val_ptr[vi];
                        let mut digit: u64 = 0;
                        if c >= 48 && c <= 57 { digit = (c - 48) as u64; }
                        else if c >= 97 && c <= 102 { digit = ((c - 97) + 10) as u64; }
                        else if c >= 65 && c <= 70 { digit = ((c - 65) + 10) as u64; }
                        v = (v * 16) + digit;
                        vi = vi + 1;
                    }
                } else {
                    while val_ptr[vi] != 0 {
                        let c: u8 = val_ptr[vi];
                        if c >= 48 && c <= 57 {
                            v = (v * 16) + ((c - 48) as u64);
                        } else if c >= 65 && c <= 70 {
                            v = (v * 16) + ((c - 55) as u64);
                        } else if c >= 97 && c <= 102 {
                            v = (v * 16) + ((c - 87) as u64);
                        }
                        vi = vi + 1;
                    }
                }
                permute_seed = v;
            } else {
                let bridge_flag: *u8 = "--arll-force-bridge";
                let mut is_bridge: u32 = 1;
                let mut bi: u64 = 0;
                while bi < 17 {
                    if arg[bi] != bridge_flag[bi] {
                        is_bridge = 0;
                    }
                    bi = bi + 1;
                }
                if is_bridge == 1 {
                    force_bridge = 1;
                }

                let upbp_flag: *u8 = "--upbp";
                let mut is_upbp_arg: u32 = 1;
                let mut ui: u64 = 0;
                while ui < 5 {
                    if arg[ui] != upbp_flag[ui] {
                        is_upbp_arg = 0;
                    }
                    ui = ui + 1;
                }
                if is_upbp_arg == 1 {
                    is_upbp = 1;
                }

                let elf_flag: *u8 = "--elf";
                let mut is_elf_arg: u32 = 1;
                let mut ei: u64 = 0;
                while ei < 5 {
                    if arg[ei] != elf_flag[ei] {
                        is_elf_arg = 0;
                    }
                    ei = ei + 1;
                }
                if is_elf_arg == 1 {
                    is_upbp = 0;
                }

                let target_flag: *u8 = "--target=";
                let mut is_target_arg: u32 = 1;
                let mut ti: u64 = 0;
                while ti < 9 {
                    if arg[ti] != target_flag[ti] {
                        is_target_arg = 0;
                    }
                    ti = ti + 1;
                }
                if is_target_arg == 1 {
                    let targ_val: *u8 = arg + 9;
                    if targ_val[0] == 97 && targ_val[1] == 114 && targ_val[2] == 109 && targ_val[3] == 54 && targ_val[4] == 52 {
                        // "arm64"
                        target_arch = 1;
                    } else if targ_val[0] == 114 && targ_val[1] == 105 && targ_val[2] == 115 && targ_val[3] == 99 && targ_val[4] == 118 && targ_val[5] == 54 && targ_val[6] == 52 {
                        // "riscv64"
                        target_arch = 2;
                    } else {
                        // "x86_64" default
                        target_arch = 0;
                    }
                }
            }
        } else {
            in_path = arg;
        }
        arg_i = arg_i + 1;
    }

    if permute_seed != 0 {
        let dummy_pad: u64 = (permute_seed % 64) * 8;
        arena_alloc(&mut parse_arena, dummy_pad as u32);
        arena_alloc(&mut cg_arena, dummy_pad as u32);
    }

    if force_bridge == 1 {
        let mut b: CallingConventionBridge;
        arll_negotiate_calling_convention(&mut b, 1, 2);
        arll_negotiate_calling_convention(&mut b, 2, 1);
    }

    // 3. Open input source file
    let fd: i64 = syscall(2, in_path, 0, 0); // SYS_open
    if fd < 0 {
        let err1: *u8 = "ERROR: Failed to open input file\n";
        syscall(1, 2, err1, 32);
        syscall(60, 1);
        return 1;
    }

    let src_buf: *mut u8 = mmap_alloc(2097152); // 2MB
    let nread: i64 = syscall(0, fd, src_buf, 2097152); // SYS_read
    syscall(3, fd);

    if nread <= 0 {
        let err2: *u8 = "ERROR: Failed to read input file\n";
        syscall(1, 2, err2, 32);
        syscall(60, 2);
        return 2;
    }

    // 4. Initialize Lexer & Parser
    let mut lexer: Lexer;
    lexer.src = src_buf;
    lexer.len = nread as u64;
    lexer.pos = 0;
    lexer.line = 1;
    lexer.col = 1;

    let mut parser: Parser;
    parser.lex = &mut lexer;
    parser.arena = &mut parse_arena;
    parser.node_count = 0;
    parser.struct_count = 0;
    parser.fn_count = 0;

    lex_next_token(parser.lex, &mut parser.cur_tok);

    // 5. Initialize CodeGen
    let mut cg: CodeGen;
    cg.text_buf = arena_alloc(&mut cg_arena, 1048576);
    cg.text_size = 0;
    cg.rodata_buf = arena_alloc(&mut cg_arena, 1048576);
    cg.rodata_size = 0;
    cg.relocs = arena_alloc(&mut cg_arena, 1048576) as *mut EiaRelocHole;
    cg.reloc_count = 0;
    cg.type_graph = arena_alloc(&mut cg_arena, 1048576) as *mut EiaTypeGraphEntry;
    cg.tg_count = 0;
    cg.contracts = arena_alloc(&mut cg_arena, 1048576) as *mut SymbolContract;
    cg.contract_count = 0;
    cg.call_main_hole = 0;
    cg.force_bridge = force_bridge as u32;
    cg.permute_seed = permute_seed as u32;
    cg.target_arch = target_arch as u32;

    cg.structs = arena_alloc(&mut cg_arena, 262144) as *mut StructInfo;
    cg.struct_count = 0;
    cg.locals = arena_alloc(&mut cg_arena, 262144) as *mut LocalVar;
    cg.local_count = 0;
    cg.current_stack_offset = 0;

    // 6. Emit _start boot patcher stub
    emit_start_stub(&mut cg);

    // 7. Parse and Compile Top-Level Items
    while parser.cur_tok.kind != 0 {
        if parser.cur_tok.kind == 10 { // TOK_STRUCT
            let snode: *mut AstNode = parse_struct(&mut parser);

            let sinfo: *mut StructInfo = ((cg.structs as *mut u8) + ((cg.struct_count as u64) * 32)) as *mut StructInfo;
            sinfo.name_hash = snode.hash;
            sinfo.type_sig_hash = snode.hash;
            sinfo.field_count = 0;
            sinfo.total_size = 0;

            let mut cur_offset: u32 = 0;
            let mut f: *mut AstNode = snode.child1;

            // Count fields first
            let mut fcount: u32 = 0;
            let mut f_temp: *mut AstNode = snode.child1;
            while f_temp != (0 as *mut AstNode) {
                fcount = fcount + 1;
                f_temp = f_temp.next;
            }

            // Permute field order if permute_seed != 0
            // Guard wire-format descriptor structs from permutation
            let mut is_wire_struct: u32 = 0;
            if sinfo.name_hash == 6275339306359764668 { is_wire_struct = 1; }
            if sinfo.name_hash == 6723681229567792751 { is_wire_struct = 1; }
            if sinfo.name_hash == 17134799602928510233 { is_wire_struct = 1; }
            if sinfo.name_hash == 1914818511609369086 { is_wire_struct = 1; }

            if cg.permute_seed != 0 && fcount >= 2 && is_wire_struct == 0 {
                let f1: *mut AstNode = snode.child1;
                let f2: *mut AstNode = f1.next;
                if f1 != (0 as *mut AstNode) && f2 != (0 as *mut AstNode) {
                    let f2_next: *mut AstNode = f2.next;
                    snode.child1 = f2;
                    f1.next = f2_next;
                    f2.next = f1;
                    f = f2; // f now points to new first field
                }
            }

            while f != (0 as *mut AstNode) {
                let mut f_size: u32 = 8;
                if f.val == 23 { f_size = 1; }
                else if f.val == 22 { f_size = 4; }
                let f_align: u32 = f_size;
                if (cur_offset % f_align) != 0 {
                    cur_offset = cur_offset + (f_align - (cur_offset % f_align));
                }

                let byte_offset: u32 = cur_offset;
                cur_offset = cur_offset + f_size;

                cg_add_type_graph_entry(&mut cg, sinfo.type_sig_hash, f.hash, byte_offset, f_size);
                sinfo.field_count = sinfo.field_count + 1;
                f = f.next;
            }

            if (cur_offset % 8) != 0 {
                cur_offset = cur_offset + (8 - (cur_offset % f_align));
            }
            sinfo.total_size = cur_offset;
            cg.struct_count = cg.struct_count + 1;

        } else if parser.cur_tok.kind == 11 { // TOK_FN
            let fnode: *mut AstNode = parse_fn(&mut parser);
            compile_fn(&mut cg, fnode);
        } else if parser.cur_tok.kind == 25 { // TOK_EXTERN
            parser_expect(&mut parser, 25);
            parser_expect(&mut parser, 11); // fn
            let ext_name_hash: u64 = parser.cur_tok.hash;
            parser_expect(&mut parser, 1);  // ident
            parser_expect(&mut parser, 60); // (
            let mut param_types_buf: [u64; 8];
            let mut param_ptrs_buf: [u64; 8];
            let p_types: *mut u64 = &mut param_types_buf[0];
            let p_ptrs: *mut u64 = &mut param_ptrs_buf[0];
            let mut param_cnt: u32 = 0;
            while parser.cur_tok.kind != 61 && parser.cur_tok.kind != 0 {
                parser_expect(&mut parser, 1);  // param name
                parser_expect(&mut parser, 70); // :
                let mut is_ptr: u32 = 0;
                if parser.cur_tok.kind == 50 { parser_expect(&mut parser, 50); is_ptr = 1; } // &
                if parser.cur_tok.kind == 13 { parser_expect(&mut parser, 13); is_ptr = 2; } // mut
                if parser.cur_tok.kind == 32 { parser_expect(&mut parser, 32); is_ptr = 1; } // *
                if parser.cur_tok.kind == 13 { parser_expect(&mut parser, 13); is_ptr = 2; } // mut
                let p_type_hash: u64 = parser.cur_tok.hash;
                lex_next_token(parser.lex, &mut parser.cur_tok); // type
                if param_cnt < 8 {
                    p_types[param_cnt as u64] = p_type_hash;
                    p_ptrs[param_cnt as u64] = is_ptr as u64;
                }
                param_cnt = param_cnt + 1;
                if parser.cur_tok.kind == 72 { parser_expect(&mut parser, 72); } // ,
            }
            parser_expect(&mut parser, 61); // )
            let mut ret_type_hash: u64 = 3563412735833858527; // "void"
            if parser.cur_tok.kind == 74 { // ->
                parser_expect(&mut parser, 74);
                ret_type_hash = parser.cur_tok.hash;
                lex_next_token(parser.lex, &mut parser.cur_tok);
            }
            if parser.cur_tok.kind == 71 { // ;
                parser_expect(&mut parser, 71);
            }

            let ext_sig_hash: u64 = compute_canonical_sig_hash(param_cnt, ret_type_hash, p_types as *u64, p_ptrs as *u64);

            // Register SymbolContract (EIA_SYM_FLAG_IMPORT = 2)
            let sc: *mut SymbolContract = ((cg.contracts as *mut u8) + ((cg.contract_count as u64) * 48)) as *mut SymbolContract;
            sc.symbol_hash = ext_name_hash;
            sc.type_sig_hash = ext_sig_hash;
            sc.vaddr = 0;
            sc.code_size = 0;
            sc.flags = 2; // EIA_SYM_FLAG_IMPORT
            sc.param_conv = param_cnt;
            sc.contract_digest = ext_sig_hash;
            cg.contract_count = cg.contract_count + 1;
        } else {
            lex_next_token(parser.lex, &mut parser.cur_tok);
        }
    }

    // GATE 3 FIX: Removed the post-pass type graph swap.
    // The parse-time field swap (above, at struct definition time) already correctly
    // reorders fields and recalculates byte offsets in the type graph.
    // The post-pass swap was swapping byte_offset values AGAIN, undoing the parse-time
    // reorder and making the chaos binary identical to the baseline (both permutations
    // cancelled each other out), causing Gate 3's chaos binary to segfault or be identical.

    // 8. Write Standalone Binary (UPBP or Native ELF)
    let write_res: i64 = write_elf64_binary(&mut cg, out_path, is_upbp);
    if write_res < 0 {
        let err3: *u8 = "ERROR: Failed to write ELF binary\n";
        syscall(1, 2, err3, 33);
        syscall(60, 3);
        return 3;
    }

    let msg: *u8 = "STAGE1 CORE1 COMPILER OK\n";
    syscall(1, 1, msg, 25);
    return 0;
}
