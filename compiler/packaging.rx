// =========================================================================
//         STAGE-1 UNIVERSAL POLYGLOT BINARY PACKAGER & ARLL BRIDGE (.rx)
//              Governed by Eternal Interface Architecture (EIA)
// =========================================================================

// -------------------------------------------------------------------------
//                         1. EIA Core Structures
// -------------------------------------------------------------------------

struct EiaRelocHole {
    insn_offset: u32,
    patch_kind: u32,
    type_sig_hash: u64,
    field_or_sym_hash: u64,
}

struct EiaTypeGraphEntry {
    type_sig_hash: u64,
    field_hash: u64,
    byte_offset: u32,
    field_size: u32,
}

struct SymbolContract {
    symbol_hash: u64,
    type_sig_hash: u64,
    vaddr: u64,
    code_size: u64,
    flags: u32,
    param_conv: u32,
    contract_digest: u64,
}

struct UniversalHologramHeader {
    magic: u32,
    version: u32,
    abi_epoch: u64,
    contracts_offset: u64,
    contracts_count: u64,
    relocs_offset: u64,
    relocs_count: u64,
    type_graph_offset: u64,
    type_graph_size: u64,
    blake3_root: u64,
    flags: u64,
    reserved0: u64,
    reserved1: u64,
}

// -------------------------------------------------------------------------
//                         2. CodeGen State
// -------------------------------------------------------------------------

struct CodeGen {
    text_buf: *mut u8,
    text_size: u32,

    rodata_buf: *mut u8,
    rodata_size: u32,

    relocs: *mut EiaRelocHole,
    reloc_count: u32,

    type_graph: *mut EiaTypeGraphEntry,
    tg_count: u32,

    contracts: *mut SymbolContract,
    contract_count: u32,

    call_main_hole: u32,
}

// -------------------------------------------------------------------------
//             3. Calling Convention Bridge (ARLL Bridge)
// -------------------------------------------------------------------------

struct CallingConventionBridge {
    from_conv: u32,
    to_conv: u32,
    thunk_size: u32,
    thunk_bytes: [u8; 64],
}

// arll_negotiate_calling_convention:
// Maps System V AMD64 argument registers (rdi, rsi, rdx, rcx, r8, r9)
// to Windows x64 argument registers (rcx, rdx, r8, r9) and allocates
// 32-byte shadow space, or vice-versa.
//
// from_conv / to_conv:
// 1 = ARLL_CONV_SYSV   (System V AMD64 ABI: Linux, macOS, BSD)
// 2 = ARLL_CONV_WIN64  (Microsoft x64 ABI: Windows)
fn arll_negotiate_calling_convention(bridge: *mut CallingConventionBridge, from_conv: u32, to_conv: u32) -> u32 {
    bridge.from_conv = from_conv;
    bridge.to_conv = to_conv;

    if from_conv == 1 && to_conv == 2 {
        // System V -> Windows x64:
        // SysV:  rdi (arg1), rsi (arg2), rdx (arg3), rcx (arg4)
        // Win64: rcx (arg1), rdx (arg2), r8  (arg3), r9  (arg4)
        // Order avoids register clobbering:
        //   mov r9, rcx       (49 89 c9) - Win arg4 <= SysV arg4
        //   mov r8, rdx       (49 89 d0) - Win arg3 <= SysV arg3
        //   mov rdx, rsi      (48 89 f2) - Win arg2 <= SysV arg2
        //   mov rcx, rdi      (48 89 f9) - Win arg1 <= SysV arg1
        //   sub rsp, 40       (48 83 ec 28) - 32-byte shadow space + 8-byte stack alignment
        //   call rax          (ff d0)
        //   add rsp, 40       (48 83 c4 28) - restore stack
        //   ret               (c3)
        let b: *mut u8 = &mut bridge.thunk_bytes[0];
        b[0] = 73;  b[1] = 137; b[2] = 201; // mov r9, rcx
        b[3] = 73;  b[4] = 137; b[5] = 208; // mov r8, rdx
        b[6] = 72;  b[7] = 137; b[8] = 242; // mov rdx, rsi
        b[9] = 72;  b[10] = 137; b[11] = 249; // mov rcx, rdi
        b[12] = 72; b[13] = 131; b[14] = 236; b[15] = 40; // sub rsp, 40
        b[16] = 255; b[17] = 208;           // call rax
        b[18] = 72; b[19] = 131; b[20] = 196; b[21] = 40; // add rsp, 40
        b[22] = 195;                        // ret
        bridge.thunk_size = 23;
        return 23;
    }

    if from_conv == 2 && to_conv == 1 {
        // Windows x64 -> System V:
        // Win64: rcx (arg1), rdx (arg2), r8  (arg3), r9  (arg4)
        // SysV:  rdi (arg1), rsi (arg2), rdx (arg3), rcx (arg4)
        //   mov rdi, rcx      (48 89 cf) - SysV arg1 <= Win arg1
        //   mov rsi, rdx      (48 89 d6) - SysV arg2 <= Win arg2
        //   mov rdx, r8       (4c 89 c2) - SysV arg3 <= Win arg3
        //   mov rcx, r9       (4c 89 c9) - SysV arg4 <= Win arg4
        //   call rax          (ff d0)
        //   ret               (c3)
        let b: *mut u8 = &mut bridge.thunk_bytes[0];
        b[0] = 72; b[1] = 137; b[2] = 207; // mov rdi, rcx
        b[3] = 72; b[4] = 137; b[5] = 214; // mov rsi, rdx
        b[6] = 76; b[7] = 137; b[8] = 194; // mov rdx, r8
        b[9] = 76; b[10] = 137; b[11] = 201; // mov rcx, r9
        b[12] = 255; b[13] = 208;          // call rax
        b[14] = 195;                       // ret
        bridge.thunk_size = 15;
        return 15;
    }

    bridge.thunk_size = 0;
    return 0;
}

// -------------------------------------------------------------------------
//             4. Schema Evolution & Widening Stencils
// -------------------------------------------------------------------------

struct SchemaEvolutionStencil {
    old_size: u32,
    new_size: u32,
    is_signed: u32,
    stencil_size: u32,
    stencil_bytes: [u8; 32],
}

// arll_emit_widening_stencil:
// Emits JIT adapter stencils that automatically inject zero-extension (movzx)
// or type-widening (movsxd, movzx) operations when a provider struct field
// evolves across versions (e.g. u32 -> u64).
fn arll_emit_widening_stencil(stencil: *mut SchemaEvolutionStencil, old_size: u32, new_size: u32, is_signed: u32) -> u32 {
    stencil.old_size = old_size;
    stencil.new_size = new_size;
    stencil.is_signed = is_signed;

    let b: *mut u8 = &mut stencil.stencil_bytes[0];

    // Case 1: Widening 32-bit -> 64-bit
    if old_size == 4 && new_size == 8 {
        if is_signed == 0 {
            // Unsigned: mov eax, dword ptr [rdi] (8B 07)
            // In x86-64, 32-bit register writes automatically zero-extend the upper 32 bits of rax!
            b[0] = 139; b[1] = 7; // mov eax, [rdi]
            b[2] = 195;           // ret
            stencil.stencil_size = 3;
            return 3;
        } else {
            // Signed: movsxd rax, dword ptr [rdi] (48 63 07)
            b[0] = 72; b[1] = 99; b[2] = 7; // movsxd rax, [rdi]
            b[3] = 195;                     // ret
            stencil.stencil_size = 4;
            return 4;
        }
    }

    // Case 2: Widening 8-bit -> 64-bit
    if old_size == 1 && new_size == 8 {
        if is_signed == 0 {
            // Unsigned: movzx rax, byte ptr [rdi] (48 0F B6 07)
            b[0] = 72; b[1] = 15; b[2] = 182; b[3] = 7; // movzx rax, byte ptr [rdi]
            b[4] = 195;                                 // ret
            stencil.stencil_size = 5;
            return 5;
        } else {
            // Signed: movsx rax, byte ptr [rdi] (48 0F BE 07)
            b[0] = 72; b[1] = 15; b[2] = 190; b[3] = 7; // movsx rax, byte ptr [rdi]
            b[4] = 195;                                 // ret
            stencil.stencil_size = 5;
            return 5;
        }
    }

    // Default: Direct 64-bit load mov rax, [rdi] (48 8B 07)
    b[0] = 72; b[1] = 139; b[2] = 7; // mov rax, [rdi]
    b[3] = 195;                      // ret
    stencil.stencil_size = 4;
    return 4;
}

// -------------------------------------------------------------------------
//         4b. Multi-OS Syscall Vector Dispatch Stencil
// -------------------------------------------------------------------------

// arll_resolve_host_syscall_vector:
// Emits the native host syscall dispatch stencil for the target host OS:
//   os_kind: 1 = Linux (syscall 0F 05),
//            2 = Windows NT (mov r10, rcx; mov eax, ssn; syscall 0F 05; ret),
//            3 = macOS Darwin (mov eax, 0x2000000 | sys_id; syscall 0F 05; ret).
fn arll_resolve_host_syscall_vector(os_kind: u64, sys_id: u64, out_stencil: *mut u8) -> u64 {
    // Linux AMD64:
    // mov eax, sys_id (B8 id0 id1 id2 id3); syscall (0F 05); ret (C3)
    if os_kind == 1 {
        out_stencil[0] = 184;
        let sid32: u32 = sys_id as u32;
        out_stencil[1] = (sid32 & 255) as u8;
        out_stencil[2] = ((sid32 >> 8) & 255) as u8;
        out_stencil[3] = ((sid32 >> 16) & 255) as u8;
        out_stencil[4] = ((sid32 >> 24) & 255) as u8;
        out_stencil[5] = 15;
        out_stencil[6] = 5;
        out_stencil[7] = 195;
        return 8;
    }

    // Windows NT AMD64:
    // mov r10, rcx (4C 8B D1); mov eax, ssn (B8 s0 s1 s2 s3); syscall (0F 05); ret (C3)
    if os_kind == 2 {
        out_stencil[0] = 76;
        out_stencil[1] = 139;
        out_stencil[2] = 209;
        out_stencil[3] = 184;
        let sid32: u32 = sys_id as u32;
        out_stencil[4] = (sid32 & 255) as u8;
        out_stencil[5] = ((sid32 >> 8) & 255) as u8;
        out_stencil[6] = ((sid32 >> 16) & 255) as u8;
        out_stencil[7] = ((sid32 >> 24) & 255) as u8;
        out_stencil[8] = 15;
        out_stencil[9] = 5;
        out_stencil[10] = 195;
        return 11;
    }

    // macOS Darwin AMD64:
    // Darwin syscalls use class 2 (UNIX) in high bits: 0x2000000 | sys_id
    // mov eax, (0x2000000 | sys_id) (B8 d0 d1 d2 d3); syscall (0F 05); ret (C3)
    if os_kind == 3 {
        out_stencil[0] = 184;
        let did32: u32 = ((sys_id as u32) | 33554432) & 4294967295; // 0x2000000 = 33554432
        out_stencil[1] = (did32 & 255) as u8;
        out_stencil[2] = ((did32 >> 8) & 255) as u8;
        out_stencil[3] = ((did32 >> 16) & 255) as u8;
        out_stencil[4] = ((did32 >> 24) & 255) as u8;
        out_stencil[5] = 15;
        out_stencil[6] = 5;
        out_stencil[7] = 195;
        return 8;
    }

    return 0;
}

// arll_host_syscall_gate_stencil:
// Emits the full host-independent syscall dispatch trampoline:
// Bridges standard POSIX arguments to the host kernel ABI.
fn arll_host_syscall_gate_stencil(os_kind: u64, out_stencil: *mut u8) -> u64 {
    // Linux AMD64:
    // mov eax, edi; mov rdi, rsi; mov rsi, rdx; mov rdx, rcx; mov r10, r8; mov r8, r9; syscall; ret
    if os_kind == 1 {
        out_stencil[0] = 137; out_stencil[1] = 248; // mov eax, edi
        out_stencil[2] = 72;  out_stencil[3] = 137; out_stencil[4] = 247; // mov rdi, rsi
        out_stencil[5] = 72;  out_stencil[6] = 137; out_stencil[7] = 209; // mov rsi, rdx
        out_stencil[8] = 72;  out_stencil[9] = 137; out_stencil[10] = 202; // mov rdx, rcx
        out_stencil[11] = 77; out_stencil[12] = 137; out_stencil[13] = 194; // mov r10, r8
        out_stencil[14] = 77; out_stencil[15] = 137; out_stencil[16] = 200; // mov r8, r9
        out_stencil[17] = 15; out_stencil[18] = 5;   // syscall
        out_stencil[19] = 195;                       // ret
        return 20;
    }
    // Windows NT AMD64:
    // mov r10, rdx; mov eax, ecx; syscall; ret
    if os_kind == 2 {
        out_stencil[0] = 76;  out_stencil[1] = 139; out_stencil[2] = 209; // mov r10, rcx
        out_stencil[3] = 137; out_stencil[4] = 248;                       // mov eax, edi
        out_stencil[5] = 15;  out_stencil[6] = 5;                         // syscall
        out_stencil[7] = 195;                                             // ret
        return 8;
    }
    // macOS Darwin AMD64:
    // mov eax, edi; or eax, 0x2000000; mov rdi, rsi; mov rsi, rdx; mov rdx, rcx; mov r10, r8; mov r8, r9; syscall; ret
    if os_kind == 3 {
        out_stencil[0] = 137; out_stencil[1] = 248; // mov eax, edi
        out_stencil[2] = 13;  out_stencil[3] = 0;   out_stencil[4] = 0; out_stencil[5] = 0; out_stencil[6] = 2; // or eax, 0x2000000
        out_stencil[7] = 72;  out_stencil[8] = 137; out_stencil[9] = 247;  // mov rdi, rsi
        out_stencil[10] = 72; out_stencil[11] = 137; out_stencil[12] = 209; // mov rsi, rdx
        out_stencil[13] = 72; out_stencil[14] = 137; out_stencil[15] = 202; // mov rdx, rcx
        out_stencil[16] = 77; out_stencil[17] = 137; out_stencil[18] = 194; // mov r10, r8
        out_stencil[19] = 77; out_stencil[20] = 137; out_stencil[21] = 200; // mov r8, r9
        out_stencil[22] = 15; out_stencil[23] = 5;   // syscall
        out_stencil[24] = 195;                       // ret
        return 25;
    }
    return 0;
}

// -------------------------------------------------------------------------
//         5. Universal Polyglot Binary Package (UPBP) Emitter
// -------------------------------------------------------------------------

// Helper: zero a memory region
fn upbp_memzero(buf: *mut u8, size: u64) {
    let mut i: u64 = 0;
    while i < size {
        buf[i] = 0;
        i = i + 1;
    }
}

// write_upbp_binary:
// Emits the unified multi-OS preamble:
//   Offset 0x000: DOS MZ executable header stub (0x4D 0x5A) with e_lfanew -> 0x140
//   Offset 0x040: POSIX shell script trampoline (#!/bin/sh\nexec "$0"\n)
//   Offset 0x080: ELF64 program headers (\x7fELF) for Linux kernels
//   Offset 0x140: PE/COFF headers (PE\0\0, x86-64, Windows CUI)
//   Offset 0x200: Mach-O 64-bit load commands (0xFEEDFACF) for macOS Darwin
//   Offset 0x400+: UniversalHologramHeader (EIAH), Contracts, Relocs, TypeGraph
//   Offset 0x10000: Native .text
//   Offset 0x30000: Native .rodata
fn write_upbp_binary(cg: *mut CodeGen, out_path: *u8) -> i64 {
    let holo_offset: u64 = 1024; // 0x400
    let contracts_offset: u64 = 1120; // 0x400 + 96 = 0x460
    let contracts_size: u64 = (cg.contract_count as u64) * 48;

    let relocs_offset: u64 = contracts_offset + contracts_size;
    let relocs_size: u64 = (cg.reloc_count as u64) * 24;

    let tg_offset: u64 = relocs_offset + relocs_size;
    let tg_size: u64 = (cg.tg_count as u64) * 24;

    let text_offset: u64 = 65536; // 0x10000
    let rodata_offset: u64 = 196608; // 0x30000
    let total_file_size: u64 = rodata_offset + 4096;

    // Allocate output file buffer via mmap
    // SYS_mmap = 9: addr=0, len=total_file_size, prot=3 (PROT_READ|PROT_WRITE), flags=34 (MAP_PRIVATE|MAP_ANONYMOUS), fd=-1, off=0
    let file_buf: *mut u8 = syscall(9, 0, total_file_size, 3, 34, -1, 0) as *mut u8;
    if (file_buf as i64) < 0 {
        return -1;
    }

    upbp_memzero(file_buf, total_file_size);

    // =====================================================================
    // 1. Offset 0x000: DOS MZ Header Stub (0x4D 0x5A)
    // =====================================================================
    file_buf[0] = 77; // 'M'
    file_buf[1] = 90; // 'Z'
    file_buf[2] = 61; // '='
    file_buf[3] = 59; // ';'
    file_buf[4] = 10; // '\n'
    file_buf[5] = 35; // '#'
    // e_lfanew at 0x3C points to PE/COFF header at 0x140
    file_buf[60] = 64;  // 0x40
    file_buf[61] = 1;   // 0x01 -> 0x00000140
    file_buf[62] = 0;
    file_buf[63] = 10;  // '\n'

    // =====================================================================
    // 2. Offset 0x040: POSIX Shell Script Trampoline
    // =====================================================================
    let tramp: *u8 = "f=/tmp/.rx_run.$$;tail -c +129 \"$0\">$f;chmod +x $f;exec $f \"$@\"\n";
    let mut ti: u64 = 0;
    while ti < 64 {
        file_buf[64 + ti] = tramp[ti];
        ti = ti + 1;
    }

    // =====================================================================
    // 3. Offset 0x080: ELF64 Header & Program Header (\x7fELF)
    // =====================================================================
    let elf_base: u64 = 128; // 0x80
    file_buf[elf_base + 0] = 127; // 0x7F
    file_buf[elf_base + 1] = 69;  // 'E'
    file_buf[elf_base + 2] = 76;  // 'L'
    file_buf[elf_base + 3] = 70;  // 'F'
    file_buf[elf_base + 4] = 2;   // ELFCLASS64
    file_buf[elf_base + 5] = 1;   // ELFDATA2LSB
    file_buf[elf_base + 6] = 1;   // EV_CURRENT
    file_buf[elf_base + 7] = 0;   // ELFOSABI_NONE

    // e_type = 2 (ET_EXEC) at elf_base + 0x10
    file_buf[elf_base + 16] = 2; file_buf[elf_base + 17] = 0;
    // e_machine = 62 (0x3E, EM_X86_64) at elf_base + 0x12
    file_buf[elf_base + 18] = 62; file_buf[elf_base + 19] = 0;
    // e_version = 1 at elf_base + 0x14
    file_buf[elf_base + 20] = 1;
    // e_entry = 0x410000 at elf_base + 0x18
    file_buf[elf_base + 24] = 0; file_buf[elf_base + 25] = 0; file_buf[elf_base + 26] = 65; file_buf[elf_base + 27] = 0;

    // e_phoff = 64 at elf_base + 0x20
    file_buf[elf_base + 32] = 64;
    // e_ehsize = 64 at elf_base + 0x34
    file_buf[elf_base + 52] = 64;
    // e_phentsize = 56 at elf_base + 0x36
    file_buf[elf_base + 54] = 56;
    // e_phnum = 1 at elf_base + 0x38
    file_buf[elf_base + 56] = 1;
    // e_shentsize = 64 at elf_base + 0x3A
    file_buf[elf_base + 58] = 64;

    // ELF64 Program Header (56 bytes at elf_base + 64 = 0xC0)
    let ph_base: u64 = elf_base + 64;
    file_buf[ph_base + 0] = 1; // p_type = 1 (PT_LOAD)
    file_buf[ph_base + 4] = 7; // p_flags = 7 (PF_R | PF_W | PF_X)
    // p_vaddr = 0x400000 at ph_base + 0x10
    file_buf[ph_base + 16] = 0; file_buf[ph_base + 17] = 0; file_buf[ph_base + 18] = 64; file_buf[ph_base + 19] = 0;
    // p_paddr = 0x400000 at ph_base + 0x18
    file_buf[ph_base + 24] = 0; file_buf[ph_base + 25] = 0; file_buf[ph_base + 26] = 64; file_buf[ph_base + 27] = 0;
    // p_filesz at ph_base + 0x20
    file_buf[ph_base + 32] = (total_file_size & 255) as u8;
    file_buf[ph_base + 33] = ((total_file_size >> 8) & 255) as u8;
    file_buf[ph_base + 34] = ((total_file_size >> 16) & 255) as u8;
    // p_memsz at ph_base + 0x28
    let memsz: u64 = total_file_size + 1048576;
    file_buf[ph_base + 40] = (memsz & 255) as u8;
    file_buf[ph_base + 41] = ((memsz >> 8) & 255) as u8;
    file_buf[ph_base + 42] = ((memsz >> 16) & 255) as u8;
    // p_align = 0x1000 at ph_base + 0x30
    file_buf[ph_base + 48] = 0; file_buf[ph_base + 49] = 16;

    // =====================================================================
    // 4. Offset 0x140: PE/COFF Headers (PE\0\0)
    // =====================================================================
    let pe_base: u64 = 320; // 0x140
    file_buf[pe_base + 0] = 80; // 'P'
    file_buf[pe_base + 1] = 69; // 'E'
    file_buf[pe_base + 2] = 0;
    file_buf[pe_base + 3] = 0;

    // COFF File Header (20 bytes at pe_base + 4)
    file_buf[pe_base + 4] = 100; file_buf[pe_base + 5] = 134; // Machine = 0x8664 (AMD64)
    file_buf[pe_base + 6] = 1;   file_buf[pe_base + 7] = 0;   // NumberOfSections = 1
    file_buf[pe_base + 20] = 240; file_buf[pe_base + 21] = 0; // SizeOfOptionalHeader = 240 (0xF0)
    file_buf[pe_base + 22] = 34;  file_buf[pe_base + 23] = 0; // Characteristics: 0x0022 (EXECUTABLE | LARGE_ADDRESS)

    // Optional Header (PE32+ 64-bit at pe_base + 24)
    let opt_base: u64 = pe_base + 24;
    file_buf[opt_base + 0] = 11; file_buf[opt_base + 1] = 2; // Magic = 0x020B (PE32+)
    file_buf[opt_base + 2] = 1;  file_buf[opt_base + 3] = 0; // MajorLinkerVersion = 1
    file_buf[opt_base + 16] = 0; file_buf[opt_base + 17] = 0; file_buf[opt_base + 18] = 1; // AddressOfEntryPoint = 0x10000
    file_buf[opt_base + 20] = 0; file_buf[opt_base + 21] = 0; file_buf[opt_base + 22] = 1; // BaseOfCode = 0x10000
    file_buf[opt_base + 24] = 0; file_buf[opt_base + 25] = 0; file_buf[opt_base + 26] = 0; file_buf[opt_base + 27] = 64; file_buf[opt_base + 28] = 1; // ImageBase = 0x140000000
    file_buf[opt_base + 32] = 0; file_buf[opt_base + 33] = 16; // SectionAlignment = 0x1000
    file_buf[opt_base + 36] = 0; file_buf[opt_base + 37] = 2;  // FileAlignment = 0x200
    file_buf[opt_base + 68] = 3; file_buf[opt_base + 69] = 0;  // Subsystem = 3 (IMAGE_SUBSYSTEM_WINDOWS_CUI)

    // =====================================================================
    // 5. Offset 0x200: Mach-O 64-bit Load Commands (0xFEEDFACF)
    // =====================================================================
    let macho_base: u64 = 512; // 0x200
    // mach_header_64 (32 bytes)
    file_buf[macho_base + 0] = 207; file_buf[macho_base + 1] = 250; file_buf[macho_base + 2] = 237; file_buf[macho_base + 3] = 254; // 0xFEEDFACF (MH_MAGIC_64)
    file_buf[macho_base + 4] = 7;   file_buf[macho_base + 5] = 0;   file_buf[macho_base + 6] = 0;   file_buf[macho_base + 7] = 1;   // CPU_TYPE_X86_64 (0x01000007)
    file_buf[macho_base + 8] = 3;   file_buf[macho_base + 9] = 0;   file_buf[macho_base + 10] = 0;  file_buf[macho_base + 11] = 128;// CPU_SUBTYPE_X86_64_ALL (0x80000003)
    file_buf[macho_base + 12] = 2;  file_buf[macho_base + 13] = 0;  // FileType = 2 (MH_EXECUTE)
    file_buf[macho_base + 16] = 1;  file_buf[macho_base + 17] = 0;  // ncmds = 1
    file_buf[macho_base + 20] = 72; file_buf[macho_base + 21] = 0;  // sizeofcmds = 72
    file_buf[macho_base + 24] = 133; file_buf[macho_base + 25] = 0; file_buf[macho_base + 26] = 32; file_buf[macho_base + 27] = 0; // flags = 0x00200085

    // LC_SEGMENT_64 (72 bytes at macho_base + 32 = 0x220)
    let seg_base: u64 = macho_base + 32;
    file_buf[seg_base + 0] = 25; // cmd = 0x19 (LC_SEGMENT_64)
    file_buf[seg_base + 4] = 72; // cmdsize = 72
    file_buf[seg_base + 8] = 95; file_buf[seg_base + 9] = 95; file_buf[seg_base + 10] = 84; file_buf[seg_base + 11] = 69; file_buf[seg_base + 12] = 88; file_buf[seg_base + 13] = 84; // "__TEXT"
    file_buf[seg_base + 32] = 0; file_buf[seg_base + 33] = 0; file_buf[seg_base + 34] = 0; file_buf[seg_base + 35] = 0; file_buf[seg_base + 36] = 1; // vmaddr = 0x100000000
    file_buf[seg_base + 40] = 0; file_buf[seg_base + 41] = 0; file_buf[seg_base + 42] = 4; // vmsize = 0x40000
    file_buf[seg_base + 56] = 7; // maxprot = 7 (RWX)
    file_buf[seg_base + 60] = 7; // initprot = 7 (RWX)

    // =====================================================================
    // 6. Offset 0x400: Universal Hologram Header (EIAH, 96 bytes)
    // =====================================================================
    let holo: *mut UniversalHologramHeader = (file_buf + holo_offset) as *mut UniversalHologramHeader;
    holo.magic = 1145588037; // 0x44484945 'EIAH'
    holo.version = 2;        // major 2, minor 0
    holo.abi_epoch = 1;
    holo.contracts_offset = contracts_offset;
    holo.contracts_count = cg.contract_count as u64;
    holo.relocs_offset = relocs_offset;
    holo.relocs_count = cg.reloc_count as u64;
    holo.type_graph_offset = tg_offset;
    holo.type_graph_size = tg_size;
    holo.blake3_root = 9833440827788927505; // 0x8877665544332211
    holo.flags = 1;

    // 7. Copy SymbolContracts
    let mut i: u64 = 0;
    let sc_src: *u8 = cg.contracts as *u8;
    while i < contracts_size {
        file_buf[contracts_offset + i] = sc_src[i];
        i = i + 1;
    }

    // 8. Copy Relocation Holes
    i = 0;
    let rel_src: *u8 = cg.relocs as *u8;
    while i < relocs_size {
        file_buf[relocs_offset + i] = rel_src[i];
        i = i + 1;
    }

    // 9. Copy Type Graph
    i = 0;
    let tg_src: *u8 = cg.type_graph as *u8;
    while i < tg_size {
        file_buf[tg_offset + i] = tg_src[i];
        i = i + 1;
    }

    // 10. Copy .text
    i = 0;
    while i < (cg.text_size as u64) {
        file_buf[text_offset + i] = cg.text_buf[i];
        i = i + 1;
    }

    // 11. Copy .rodata
    i = 0;
    while i < (cg.rodata_size as u64) {
        file_buf[rodata_offset + i] = cg.rodata_buf[i];
        i = i + 1;
    }

    // 12. Write executable binary to disk
    // SYS_open = 2: path, flags=O_CREAT|O_WRONLY|O_TRUNC (577), mode=0755 (493)
    let fd: i64 = syscall(2, out_path, 577, 493);
    if fd < 0 {
        return -2;
    }

    syscall(1, fd, file_buf, total_file_size); // SYS_write
    syscall(3, fd);                            // SYS_close
    return 0;
}

// -------------------------------------------------------------------------
//                6. Verification Test Runner (Self-Test)
// -------------------------------------------------------------------------

fn main() -> i64 {
    // Test 1: Verify Calling Convention Bridge
    let mut bridge: CallingConventionBridge;
    let sz1: u32 = arll_negotiate_calling_convention(&mut bridge, 1, 2);
    if sz1 != 23 {
        return 1;
    }
    let sz2: u32 = arll_negotiate_calling_convention(&mut bridge, 2, 1);
    if sz2 != 15 {
        return 2;
    }

    // Test 2: Verify Schema Evolution Stencil
    let mut stencil: SchemaEvolutionStencil;
    let w_sz: u32 = arll_emit_widening_stencil(&mut stencil, 4, 8, 0);
    if w_sz != 3 {
        return 3;
    }

    // Test 3: Verify Multi-OS Syscall Vector Resolution
    let mut sys_buf: [u8; 16];
    let l_sz: u64 = arll_resolve_host_syscall_vector(1, 1, &mut sys_buf[0]);
    if l_sz != 8 || sys_buf[5] != 15 || sys_buf[6] != 5 {
        return 4;
    }
    let win_sz: u64 = arll_resolve_host_syscall_vector(2, 42, &mut sys_buf[0]);
    if win_sz != 11 || sys_buf[0] != 76 || sys_buf[8] != 15 {
        return 5;
    }
    let d_sz: u64 = arll_resolve_host_syscall_vector(3, 4, &mut sys_buf[0]);
    if d_sz != 8 || sys_buf[5] != 15 || sys_buf[6] != 5 {
        return 6;
    }

    // Test 4: Verify Full Multi-OS Syscall Gate Trampolines
    let mut gate_buf: [u8; 32];
    let gl_sz: u64 = arll_host_syscall_gate_stencil(1, &mut gate_buf[0]);
    if gl_sz != 20 || gate_buf[0] != 137 || gate_buf[17] != 15 || gate_buf[18] != 5 {
        return 7;
    }
    let gwin_sz: u64 = arll_host_syscall_gate_stencil(2, &mut gate_buf[0]);
    if gwin_sz != 8 || gate_buf[0] != 76 || gate_buf[5] != 15 || gate_buf[6] != 5 {
        return 8;
    }
    let gd_sz: u64 = arll_host_syscall_gate_stencil(3, &mut gate_buf[0]);
    if gd_sz != 25 || gate_buf[0] != 137 || gate_buf[22] != 15 || gate_buf[23] != 5 {
        return 9;
    }

    // Print verification message
    let msg: [u8; 32];
    msg[0] = 83;  // 'S'
    msg[1] = 84;  // 'T'
    msg[2] = 65;  // 'A'
    msg[3] = 71;  // 'G'
    msg[4] = 69;  // 'E'
    msg[5] = 49;  // '1'
    msg[6] = 32;  // ' '
    msg[7] = 85;  // 'U'
    msg[8] = 80;  // 'P'
    msg[9] = 66;  // 'B'
    msg[10] = 80; // 'P'
    msg[11] = 32; // ' '
    msg[12] = 80; // 'P'
    msg[13] = 65; // 'A'
    msg[14] = 67; // 'C'
    msg[15] = 75; // 'K'
    msg[16] = 65; // 'A'
    msg[17] = 71; // 'G'
    msg[18] = 73; // 'I'
    msg[19] = 78; // 'N'
    msg[20] = 71; // 'G'
    msg[21] = 32; // ' '
    msg[22] = 79; // 'O'
    msg[23] = 75; // 'K'
    msg[24] = 10; // '\n'
    syscall(1, 1, &msg[0], 25);

    return 42;
}
