// =========================================================================
//            STAGE-1 SELF-HOSTED EIA RUNTIME & DVAM SUBSTRATE (.rx)
//              Governed by Eternal Interface Architecture (EIA)
// =========================================================================

// -------------------------------------------------------------------------
//                    1. EIA Canonical Binary Contract Structs
// -------------------------------------------------------------------------

struct UniversalHologramHeader {
    magic: u32,
    version: u32,
    abi_epoch: u64,
    contracts_offset: u64,
    contracts_count: u64,
    relocs_offset: u64,
    relocs_count: u64,
    type_graph_offset: u64,
    type_graph_size: u64,
    blake3_root: u64,
    flags: u64,
    reserved0: u64,
    reserved1: u64,
}

struct SymbolContract {
    symbol_hash: u64,
    type_sig_hash: u64,
    vaddr: u64,
    code_size: u64,
    flags: u32,
    param_conv: u32,
    contract_digest: u64,
}

struct EiaRelocHole {
    insn_offset: u32,
    patch_kind: u32,
    type_sig_hash: u64,
    field_or_sym_hash: u64,
}

struct EiaTypeGraphEntry {
    type_sig_hash: u64,
    field_hash: u64,
    byte_offset: u32,
    field_size: u32,
}

struct DvamArena {
    fd: i64,
    v_write: *mut u8,
    v_exec: *u8,
    size: u64,
    generation: u64,
    alloc_offset: u64,
}

struct GdamState {
    current_epoch: u64,
    staged_schema: *mut EiaTypeGraphEntry,
    staged_count: u64,
    entry_vector: *u8,
}

struct Timespec {
    sec: i64,
    nsec: i64,
}

struct TestStruct {
    f0: u64,
    f1: u64,
    f2: u64,
}

// -------------------------------------------------------------------------
//           2. Real BLAKE3-64 Hashing Algorithm & Schema Loader
// -------------------------------------------------------------------------

fn rotr32(x: u32, n: u32) -> u32 {
    let x32: u32 = x & 4294967295;
    let r: u32 = x32 >> n;
    let l: u32 = (x32 << (32 - n)) & 4294967295;
    return (r | l) & 4294967295;
}

fn get_u32(buf: *u8, idx: u64) -> u32 {
    let p: *u8 = buf + (idx * 4);
    let b0: u32 = p[0] as u32;
    let b1: u32 = p[1] as u32;
    let b2: u32 = p[2] as u32;
    let b3: u32 = p[3] as u32;
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 4294967295;
}

fn set_u32(buf: *mut u8, idx: u64, val: u32) {
    let p: *mut u8 = buf + (idx * 4);
    p[0] = (val & 255) as u8;
    p[1] = ((val >> 8) & 255) as u8;
    p[2] = ((val >> 16) & 255) as u8;
    p[3] = ((val >> 24) & 255) as u8;
}

fn blake3_round_g(state: *mut u8, msg: *u8, step: u64) {
    let mut a_idx: u64 = 0;
    let mut b_idx: u64 = 0;
    let mut c_idx: u64 = 0;
    let mut d_idx: u64 = 0;
    let mx_idx: u64 = step * 2;
    let my_idx: u64 = (step * 2) + 1;

    if step == 0 { a_idx = 0; b_idx = 4; c_idx = 8;  d_idx = 12; }
    else if step == 1 { a_idx = 1; b_idx = 5; c_idx = 9;  d_idx = 13; }
    else if step == 2 { a_idx = 2; b_idx = 6; c_idx = 10; d_idx = 14; }
    else if step == 3 { a_idx = 3; b_idx = 7; c_idx = 11; d_idx = 15; }
    else if step == 4 { a_idx = 0; b_idx = 5; c_idx = 10; d_idx = 15; }
    else if step == 5 { a_idx = 1; b_idx = 6; c_idx = 11; d_idx = 12; }
    else if step == 6 { a_idx = 2; b_idx = 7; c_idx = 8;  d_idx = 13; }
    else if step == 7 { a_idx = 3; b_idx = 4; c_idx = 9;  d_idx = 14; }

    let mx: u32 = get_u32(msg, mx_idx);
    let my: u32 = get_u32(msg, my_idx);

    let mut a: u32 = get_u32(state, a_idx);
    let mut b: u32 = get_u32(state, b_idx);
    let mut c: u32 = get_u32(state, c_idx);
    let mut d: u32 = get_u32(state, d_idx);

    a = (a + b + mx) & 4294967295;
    d = rotr32(d ^ a, 16);
    c = (c + d) & 4294967295;
    b = rotr32(b ^ c, 12);
    a = (a + b + my) & 4294967295;
    d = rotr32(d ^ a, 8);
    c = (c + d) & 4294967295;
    b = rotr32(b ^ c, 7);

    set_u32(state, a_idx, a);
    set_u32(state, b_idx, b);
    set_u32(state, c_idx, c);
    set_u32(state, d_idx, d);
}

fn blake3_permute_msg(msg: *mut u8) {
    let mut temp: [u8; 64];
    let t: *mut u8 = &mut temp[0];
    let mut i: u64 = 0;
    while i < 16 {
        set_u32(t, i, get_u32(msg, i));
        i = i + 1;
    }
    set_u32(msg, 0,  get_u32(t, 2));
    set_u32(msg, 1,  get_u32(t, 6));
    set_u32(msg, 2,  get_u32(t, 3));
    set_u32(msg, 3,  get_u32(t, 10));
    set_u32(msg, 4,  get_u32(t, 7));
    set_u32(msg, 5,  get_u32(t, 0));
    set_u32(msg, 6,  get_u32(t, 4));
    set_u32(msg, 7,  get_u32(t, 13));
    set_u32(msg, 8,  get_u32(t, 1));
    set_u32(msg, 9,  get_u32(t, 11));
    set_u32(msg, 10, get_u32(t, 12));
    set_u32(msg, 11, get_u32(t, 5));
    set_u32(msg, 12, get_u32(t, 9));
    set_u32(msg, 13, get_u32(t, 14));
    set_u32(msg, 14, get_u32(t, 15));
    set_u32(msg, 15, get_u32(t, 8));
}

fn blake3_compress_64(cv: *mut u8, block_buf: *u8, block_len: u32, block_index: u64, flags: u32) -> u64 {
    let mut state_buf: [u8; 64];
    let state: *mut u8 = &mut state_buf[0];

    // Initialize state with chaining value (words 0..7)
    let mut i: u64 = 0;
    while i < 8 {
        set_u32(state, i, get_u32(cv, i));
        i = i + 1;
    }
    // Initialize state words 8..11 with official BLAKE3 IV
    set_u32(state, 8,  1779033703); // 0x6A09E667
    set_u32(state, 9,  3144134277); // 0xBB67AE85
    set_u32(state, 10, 1013904242); // 0x3C6EF372
    set_u32(state, 11, 2773480762); // 0xA54FF53A
    // Counter low and high
    set_u32(state, 12, (block_index & 4294967295) as u32);
    set_u32(state, 13, ((block_index >> 32) & 4294967295) as u32);
    // Block len and flags
    set_u32(state, 14, block_len);
    set_u32(state, 15, flags);

    // Prepare message buffer (64 bytes)
    let mut msg_buf: [u8; 64];
    let msg: *mut u8 = &mut msg_buf[0];
    i = 0;
    while i < 64 {
        if i < (block_len as u64) {
            msg[i] = block_buf[i];
        } else {
            msg[i] = 0;
        }
        i = i + 1;
    }

    // 7 BLAKE3 compression rounds
    let mut round: u64 = 0;
    while round < 7 {
        let mut step: u64 = 0;
        while step < 8 {
            blake3_round_g(state, msg, step);
            step = step + 1;
        }

        if round < 6 {
            blake3_permute_msg(msg);
        }
        round = round + 1;
    }

    // Update chaining value
    i = 0;
    while i < 8 {
        let new_cv_word: u32 = get_u32(state, i) ^ get_u32(state, i + 8);
        set_u32(cv, i, new_cv_word);
        i = i + 1;
    }

    let low: u64 = (get_u32(cv, 0) as u64) & 4294967295;
    let high: u64 = (get_u32(cv, 1) as u64) & 4294967295;
    return low | (high << 32);
}

fn blake3_init_cv(cv: *mut u8) {
    set_u32(cv, 0, 1779033703); // 0x6A09E667
    set_u32(cv, 1, 3144134277); // 0xBB67AE85
    set_u32(cv, 2, 1013904242); // 0x3C6EF372
    set_u32(cv, 3, 2773480762); // 0xA54FF53A
    set_u32(cv, 4, 1359893119); // 0x510E527F
    set_u32(cv, 5, 2600822924); // 0x9B05688C
    set_u32(cv, 6, 528734635);  // 0x1F83D9AB
    set_u32(cv, 7, 1541459225); // 0x5BE0CD19
}

fn blake3_hash_chunk(chunk_data: *u8, chunk_len: u64, chunk_counter: u64, is_root: u32, out_cv: *mut u8) {
    blake3_init_cv(out_cv);
    if chunk_len == 0 {
        let mut flags: u32 = 1 | 2; // CHUNK_START | CHUNK_END
        if is_root == 1 { flags = flags | 8; }
        blake3_compress_64(out_cv, chunk_data, 0, chunk_counter, flags);
        return;
    }
    let num_blocks: u64 = (chunk_len + 63) / 64;
    let mut b: u64 = 0;
    let mut blk_off: u64 = 0;
    while b < num_blocks {
        let mut blk_len: u32 = 64;
        if (chunk_len - blk_off) < 64 {
            blk_len = (chunk_len - blk_off) as u32;
        }
        let mut flags: u32 = 0;
        if b == 0 { flags = flags | 1; } // CHUNK_START
        if b == (num_blocks - 1) {
            flags = flags | 2; // CHUNK_END
            if is_root == 1 { flags = flags | 8; }
        }
        blake3_compress_64(out_cv, chunk_data + blk_off, blk_len, chunk_counter, flags);
        blk_off = blk_off + (blk_len as u64);
        b = b + 1;
    }
}

fn blake3_parent_cv(left_cv: *u8, right_cv: *u8, is_root: u32, out_cv: *mut u8) {
    let mut block_buf: [u8; 64];
    let block: *mut u8 = &mut block_buf[0];
    let mut i: u64 = 0;
    while i < 32 {
        block[i] = left_cv[i];
        block[i + 32] = right_cv[i];
        i = i + 1;
    }
    blake3_init_cv(out_cv);
    let mut flags: u32 = 4; // PARENT
    if is_root == 1 { flags = flags | 8; }
    blake3_compress_64(out_cv, block, 64, 0, flags);
}

fn blake3_hash64(buf: *u8, len: u64) -> u64 {
    let mut root_cv_buf: [u8; 32];
    let root_cv: *mut u8 = &mut root_cv_buf[0];

    if len <= 1024 {
        blake3_hash_chunk(buf, len, 0, 1, root_cv);
        let low: u64 = (get_u32(root_cv, 0) as u64) & 4294967295;
        let high: u64 = (get_u32(root_cv, 1) as u64) & 4294967295;
        return low | (high << 32);
    }

    let num_chunks: u64 = (len + 1023) / 1024;
    let mut stack_cv_buf: [u8; 2048];
    let mut cv_list: *mut u8 = &mut stack_cv_buf[0];
    let mut is_allocated: u32 = 0;
    let cv_bytes: u64 = ((num_chunks * 32) + 4095) & ~4095;
    if num_chunks > 64 {
        if num_chunks > 1048576 { return 0; }
        let ptr: *mut u8 = syscall(9, 0, cv_bytes, 3, 34, -1, 0) as *mut u8;
        if (ptr as i64) > 0 {
            cv_list = ptr;
            is_allocated = 1;
        } else {
            return 0;
        }
    }

    let mut c: u64 = 0;
    while c < num_chunks {
        let c_off: u64 = c * 1024;
        let mut c_len: u64 = 1024;
        if (len - c_off) < 1024 {
            c_len = len - c_off;
        }
        blake3_hash_chunk(buf + c_off, c_len, c, 0, cv_list + (c * 32));
        c = c + 1;
    }

    let mut cv_count: u64 = num_chunks;

    while cv_count > 1 {
        let mut next_count: u64 = 0;
        let mut idx: u64 = 0;
        while idx < cv_count {
            if (idx + 1) < cv_count {
                let mut is_root: u32 = 0;
                if cv_count == 2 { is_root = 1; }
                let mut p_cv_buf: [u8; 32];
                let p_cv: *mut u8 = &mut p_cv_buf[0];
                blake3_parent_cv(cv_list + (idx * 32), cv_list + ((idx + 1) * 32), is_root, p_cv);
                let mut k: u64 = 0;
                while k < 32 {
                    cv_list[(next_count * 32) + k] = p_cv[k];
                    k = k + 1;
                }
                next_count = next_count + 1;
            } else {
                let mut k: u64 = 0;
                while k < 32 {
                    cv_list[(next_count * 32) + k] = cv_list[(idx * 32) + k];
                    k = k + 1;
                }
                next_count = next_count + 1;
            }
            idx = idx + 2;
        }
        cv_count = next_count;
    }

    let low: u64 = (get_u32(cv_list, 0) as u64) & 4294967295;
    let high: u64 = (get_u32(cv_list, 1) as u64) & 4294967295;
    if is_allocated == 1 {
        syscall(11, cv_list, cv_bytes); // SYS_munmap
    }
    return low | (high << 32);
}

fn eia_load_schema(base_ptr: *u8) -> *UniversalHologramHeader {
    let mut holo: *UniversalHologramHeader = (base_ptr + 1024) as *UniversalHologramHeader;
    // Magic check: 0x44484945 ('EIAH')
    if holo.magic != 1145588037 {
        holo = (base_ptr + 128) as *UniversalHologramHeader;
    }
    if holo.magic != 1145588037 {
        return 0 as *UniversalHologramHeader;
    }

    // Verify dynamic BLAKE3-64 digest over tables
    let contracts_ptr: *u8 = base_ptr + holo.contracts_offset;
    let tables_len: u64 = (holo.contracts_count * 48) + (holo.relocs_count * 24) + holo.type_graph_size;
    let computed_root: u64 = blake3_hash64(contracts_ptr, tables_len);
    if holo.blake3_root != computed_root {
        return 0 as *UniversalHologramHeader;
    }

    return holo;
}

fn eia_compute_contract_digest(buf: *u8, len: u64) -> u64 {
    return blake3_hash64(buf, len);
}

fn eia_resolve_field_displacement(tg_entries: *mut EiaTypeGraphEntry, tg_count: u64, type_hash: u64, field_hash: u64) -> i64 {
    let mut i: u64 = 0;
    while i < tg_count {
        let entry: *mut EiaTypeGraphEntry = ((tg_entries as *mut u8) + (i * 24)) as *mut EiaTypeGraphEntry;
        if entry.type_sig_hash == type_hash && entry.field_hash == field_hash {
            return entry.byte_offset as i64;
        }
        i = i + 1;
    }
    return -1;
}

// -------------------------------------------------------------------------
//           2b. EIA Image Validation & Fail-Closed Loading
// -------------------------------------------------------------------------

// Validate that the instruction at ptr supports the declared patch kind.
// patch_kind == 1 = EIA_PATCH_FIELD_DISP32 (lea rdi, [rsi + disp32]).
// Returns 0 if valid, negative error code otherwise.
fn eia_validate_instruction(ptr: *mut u8, patch_kind: u32) -> i64 {
    if patch_kind == 1 {
        // Expected encoding: 48 8d XX ?? ?? ?? ?? (lea r/m64, [r/m64 + disp32])
        // modrm byte: mod=00, reg=111 (rdi for 64-bit), rm=110 (SIB follows)
        // SIB byte: scale=00, index=101 (none), base=110 (rsi)
        if ptr[0] != 72 {
            return -9; // Not REX.W prefix
        }
        if ptr[1] != 141 {
            return -9; // Not LEA opcode
        }
        let modrm: u32 = ptr[2] as u32;
        if modrm != 190 {
            return -9; // Not mod=00, reg=111, rm=110 (lea rdi, [rsi + disp32])
        }
        // Byte 3-6: 32-bit displacement (the hole)
        // No further constraint on displacement value itself
        return 0;
    }
    return -9; // Unknown patch kind
}

// Validate the complete EIA image before any patching occurs.
// Returns 0 if fully valid, negative error code otherwise.
fn eia_validate_image(v_base: *mut u8, size: u64) -> i64 {
    // 1. Minimum size: header must fit
    if size < 96 {
        return -3; // Truncated header
    }

    // 2. Read hologram header fields
    let magic: u32 = (v_base[0] as u32) | ((v_base[1] as u32) << 8) | ((v_base[2] as u32) << 16) | ((v_base[3] as u32) << 24);
    if magic != 1145588037 {
        return -1; // Invalid magic (not EIAH)
    }

    let version: u32 = (v_base[4] as u32) | ((v_base[5] as u32) << 8) | ((v_base[6] as u32) << 16) | ((v_base[7] as u32) << 24);
    if version != 2 {
        return -2; // Unsupported version
    }

    let abi_epoch: u64 = 0; // reserved for future
    let _unused_epoch: u64 = abi_epoch;

    // contracts_offset at 0x10 (8 bytes)
    let contracts_offset: u64 = (v_base[0x10] as u64) | ((v_base[0x11] as u64) << 8) | ((v_base[0x12] as u64) << 16) | ((v_base[0x13] as u64) << 24) |
                                ((v_base[0x14] as u64) << 32) | ((v_base[0x15] as u64) << 40) | ((v_base[0x16] as u64) << 48) | ((v_base[0x17] as u64) << 56);
    let contracts_count: u64 = (v_base[0x18] as u64) | ((v_base[0x19] as u64) << 8) | ((v_base[0x19] as u64) << 16) | ((v_base[0x1b] as u64) << 24) |
                               ((v_base[0x1c] as u64) << 32) | ((v_base[0x1d] as u64) << 40) | ((v_base[0x1e] as u64) << 48) | ((v_base[0x1f] as u64) << 56);
    let relocs_offset: u64 = (v_base[0x20] as u64) | ((v_base[0x21] as u64) << 8) | ((v_base[0x22] as u64) << 16) | ((v_base[0x23] as u64) << 24) |
                             ((v_base[0x24] as u64) << 32) | ((v_base[0x25] as u64) << 40) | ((v_base[0x26] as u64) << 48) | ((v_base[0x27] as u64) << 56);
    let relocs_count: u64 = (v_base[0x28] as u64) | ((v_base[0x29] as u64) << 8) | ((v_base[0x2a] as u64) << 16) | ((v_base[0x2b] as u64) << 24) |
                            ((v_base[0x2c] as u64) << 32) | ((v_base[0x2d] as u64) << 40) | ((v_base[0x2e] as u64) << 48) | ((v_base[0x2f] as u64) << 56);
    let type_graph_offset: u64 = (v_base[0x30] as u64) | ((v_base[0x31] as u64) << 8) | ((v_base[0x32] as u64) << 16) | ((v_base[0x33] as u64) << 24) |
                                 ((v_base[0x34] as u64) << 32) | ((v_base[0x35] as u64) << 40) | ((v_base[0x36] as u64) << 48) | ((v_base[0x37] as u64) << 56);
    let type_graph_size: u64 = (v_base[0x38] as u64) | ((v_base[0x39] as u64) << 8) | ((v_base[0x39] as u64) << 16) | ((v_base[0x3b] as u64) << 24) |
                               ((v_base[0x3c] as u64) << 32) | ((v_base[0x3d] as u64) << 40) | ((v_base[0x3e] as u64) << 48) | ((v_base[0x3f] as u64) << 56);

    // 3. Overflow checks for table bounds
    // contracts_offset + contracts_count * 48 must not overflow and must fit in image
    let contracts_mul: u64 = contracts_count * 48;
    if contracts_mul / 48 != contracts_count {
        return -5; // Integer overflow in contracts table size
    }
    let contracts_end: u64 = contracts_offset + contracts_mul;
    if contracts_end < contracts_offset {
        return -5; // Integer overflow in contracts_end
    }
    if contracts_end > size {
        return -4; // Contracts table extends beyond image
    }

    // relocs_offset + relocs_count * 24 must not overflow and must fit in image
    let relocs_mul: u64 = relocs_count * 24;
    if relocs_mul / 24 != relocs_count {
        return -5; // Integer overflow in relocs table size
    }
    let relocs_end: u64 = relocs_offset + relocs_mul;
    if relocs_end < relocs_offset {
        return -5; // Integer overflow in relocs_end
    }
    if relocs_end > size {
        return -4; // Relocs table extends beyond image
    }

    // type_graph_offset + type_graph_size must not overflow and must fit in image
    let tg_end: u64 = type_graph_offset + type_graph_size;
    if tg_end < type_graph_offset {
        return -5; // Integer overflow in type graph end
    }
    if tg_end > size {
        return -4; // Type graph extends beyond image
    }

    // 4. Validate type graph entries
    // type_graph_size must be a multiple of 24
    if type_graph_size % 24 != 0 {
        return -6; // Invalid type graph size (not multiple of entry size)
    }
    let tg_count: u64 = type_graph_size / 24;
    let mut i: u64 = 0;
    while i < tg_count {
        let entry_ptr: *mut u8 = v_base + type_graph_offset + (i * 24);
        let t_type_sig: u64 = (entry_ptr[0] as u64) | ((entry_ptr[1] as u64) << 8) | ((entry_ptr[2] as u64) << 16) | ((entry_ptr[3] as u64) << 24) |
                              ((entry_ptr[4] as u64) << 32) | ((entry_ptr[5] as u64) << 40) | ((entry_ptr[6] as u64) << 48) | ((entry_ptr[7] as u64) << 56);
        let t_field_hash: u64 = (entry_ptr[8] as u64) | ((entry_ptr[9] as u64) << 8) | ((entry_ptr[10] as u64) << 16) | ((entry_ptr[11] as u64) << 24) |
                                ((entry_ptr[12] as u64) << 32) | ((entry_ptr[13] as u64) << 40) | ((entry_ptr[14] as u64) << 48) | ((entry_ptr[15] as u64) << 56);
        let t_byte_offset: u32 = (entry_ptr[16] as u32) | ((entry_ptr[17] as u32) << 8) | ((entry_ptr[18] as u32) << 16) | ((entry_ptr[19] as u32) << 24);
        let t_field_size: u32 = (entry_ptr[20] as u32) | ((entry_ptr[21] as u32) << 8) | ((entry_ptr[22] as u32) << 16) | ((entry_ptr[23] as u32) << 24);
        let _unused_sig: u64 = t_type_sig;
        let _unused_hash: u64 = t_field_hash;
        // field_size must be non-zero and one of: 1, 2, 4, 8
        if t_field_size == 0 || (t_field_size != 1 && t_field_size != 2 && t_field_size != 4 && t_field_size != 8) {
            return -6; // Invalid field size in type graph entry
        }
        // byte_offset + field_size must not overflow u32
        if (t_byte_offset as u64) + (t_field_size as u64) > 4294967295 {
            return -5; // Integer overflow in field bounds
        }
        i = i + 1;
    }

    // 5. Validate all relocation holes
    // Check that each reloc references a resolvable field, offset is valid,
    // instruction encoding supports patch kind, and no duplicates/overlaps.
    let mut j: u64 = 0;
    while j < relocs_count {
        let reloc_ptr: *mut u8 = v_base + relocs_offset + (j * 24);
        let r_insn_offset: u32 = (reloc_ptr[0] as u32) | ((reloc_ptr[1] as u32) << 8) | ((reloc_ptr[2] as u32) << 16) | ((reloc_ptr[3] as u32) << 24);
        let r_patch_kind: u32 = (reloc_ptr[4] as u32) | ((reloc_ptr[5] as u32) << 8) | ((reloc_ptr[6] as u32) << 16) | ((reloc_ptr[7] as u32) << 24);
        let r_type_sig: u64 = (reloc_ptr[8] as u64) | ((reloc_ptr[9] as u64) << 8) | ((reloc_ptr[10] as u64) << 16) | ((reloc_ptr[11] as u64) << 24) |
                              ((reloc_ptr[12] as u64) << 32) | ((reloc_ptr[13] as u64) << 40) | ((reloc_ptr[14] as u64) << 48) | ((reloc_ptr[15] as u64) << 56);
        let r_field_hash: u64 = (reloc_ptr[16] as u64) | ((reloc_ptr[17] as u64) << 8) | ((reloc_ptr[18] as u64) << 16) | ((reloc_ptr[19] as u64) << 24) |
                                ((reloc_ptr[20] as u64) << 32) | ((reloc_ptr[21] as u64) << 40) | ((reloc_ptr[22] as u64) << 48) | ((reloc_ptr[23] as u64) << 56);

        // Check patch kind is supported
        if r_patch_kind != 1 {
            return -9; // Unsupported patch kind
        }

        // Check instruction encoding supports this patch kind
        let insn_ptr: *mut u8 = v_base + (r_insn_offset as u64);
        let inst_res: i64 = eia_validate_instruction(insn_ptr, r_patch_kind);
        if inst_res != 0 {
            return inst_res; // Invalid instruction encoding
        }

        // Check that the field can be resolved in the type graph
        let mut k: u64 = 0;
        let mut found: u32 = 0;
        let mut field_size_at_offset: u32 = 0;
        while k < tg_count {
            let entry_ptr: *mut u8 = v_base + type_graph_offset + (k * 24);
            let e_type_sig: u64 = (entry_ptr[0] as u64) | ((entry_ptr[1] as u64) << 8) | ((entry_ptr[2] as u64) << 16) | ((entry_ptr[3] as u64) << 24) |
                                  ((entry_ptr[4] as u64) << 32) | ((entry_ptr[5] as u64) << 40) | ((entry_ptr[6] as u64) << 48) | ((entry_ptr[7] as u64) << 56);
            let e_field_hash: u64 = (entry_ptr[8] as u64) | ((entry_ptr[9] as u64) << 8) | ((entry_ptr[10] as u64) << 16) | ((entry_ptr[11] as u64) << 24) |
                                    ((entry_ptr[12] as u64) << 32) | ((entry_ptr[13] as u64) << 40) | ((entry_ptr[14] as u64) << 48) | ((entry_ptr[15] as u64) << 56);
            let e_byte_offset: u32 = (entry_ptr[16] as u32) | ((entry_ptr[17] as u32) << 8) | ((entry_ptr[18] as u32) << 16) | ((entry_ptr[19] as u32) << 24);
            let e_field_size: u32 = (entry_ptr[20] as u32) | ((entry_ptr[21] as u32) << 8) | ((entry_ptr[22] as u32) << 16) | ((entry_ptr[23] as u32) << 24);
            if e_type_sig == r_type_sig && e_field_hash == r_field_hash {
                found = 1;
                field_size_at_offset = e_field_size;
                k = tg_count; // break
            }
            k = k + 1;
        }
        if found == 0 {
            return -7; // Missing field resolution (field not in type graph)
        }

        // Check for width mismatch: patch_kind==1 writes 4 bytes, field_size must be >= 4
        // or an adapter must be present (not supported yet, so reject width mismatch)
        if field_size_at_offset < 4 {
            return -11; // Field-width mismatch: no supported adapter for width < 4 bytes
        }

        // Check for duplicate/overlapping relocation sites
        // Each reloc writes 4 bytes at insn_offset+3 (the displacement field)
        // Overlap if two relocs write to overlapping byte ranges
        let m: u64 = 0;
        while m < relocs_count {
            if m != j {
                let reloc_ptr2: *mut u8 = v_base + relocs_offset + (m * 24);
                let r2_insn_offset: u32 = (reloc_ptr2[0] as u32) | ((reloc_ptr2[1] as u32) << 8) | ((reloc_ptr2[2] as u32) << 16) | ((reloc_ptr2[3] as u32) << 24);
                // Two 4-byte displacement writes overlap if their insn_offsets are within 4 bytes of each other
                let diff: i64 = (r_insn_offset as i64) - (r2_insn_offset as i64);
                if diff >= -3 && diff <= 3 {
                    return -10; // Duplicate or overlapping relocation sites
                }
            }
            m = m + 1;
        }

        j = j + 1;
    }

    // 6. Validate integrity hash (BLAKE3-64 root)
    let blake3_root: u64 = (v_base[0x40] as u64) | ((v_base[0x41] as u64) << 8) | ((v_base[0x42] as u64) << 16) | ((v_base[0x43] as u64) << 24) |
                           ((v_base[0x44] as u64) << 32) | ((v_base[0x45] as u64) << 40) | ((v_base[0x46] as u64) << 48) | ((v_base[0x47] as u64) << 56);
    let tables_len: u64 = (contracts_count * 48) + (relocs_count * 24) + type_graph_size;
    let computed_root: u64 = blake3_hash64(v_base + contracts_offset, tables_len);
    if blake3_root != computed_root {
        return -12; // Invalid integrity hash
    }

    return 0; // Image fully valid
}

// -------------------------------------------------------------------------
//           3. Dual Virtual Alias Mapping (DVAM — Strict W ^ X)
// -------------------------------------------------------------------------

fn dvam_create(arena: *mut DvamArena, size: u64) -> i64 {
    // 1. SYS_memfd_create = 319: name="dvam_arena", flags=0
    let name: *u8 = "dvam_arena";
    let fd: i64 = syscall(319, name, 0);
    if fd < 0 {
        return -1;
    }

    // 2. SYS_ftruncate = 77: fd, length=size
    let trunc_res: i64 = syscall(77, fd, size);
    if trunc_res < 0 {
        syscall(3, fd);
        return -2;
    }

    // 3. SYS_mmap = 9 for v_write: addr=0, len=size, prot=3 (PROT_READ|PROT_WRITE), flags=1 (MAP_SHARED), fd, offset=0
    let w_ptr: *mut u8 = syscall(9, 0, size, 3, 1, fd, 0) as *mut u8;
    if (w_ptr as i64) < 0 {
        syscall(3, fd);
        return -3;
    }

    // 4. SYS_mmap = 9 for v_exec: addr=0, len=size, prot=5 (PROT_READ|PROT_EXEC), flags=1 (MAP_SHARED), fd, offset=0
    let x_ptr: *u8 = syscall(9, 0, size, 5, 1, fd, 0) as *u8;
    if (x_ptr as i64) < 0 {
        syscall(11, w_ptr, size); // SYS_munmap
        syscall(3, fd);
        return -4;
    }

    arena.fd = fd;
    arena.v_write = w_ptr;
    arena.v_exec = x_ptr;
    arena.size = size;
    arena.generation = 1;
    arena.alloc_offset = 0;
    return 0;
}

fn dvam_alloc(arena: *mut DvamArena, bytes: u64) -> *mut u8 {
    let aligned: u64 = ((bytes + 15) / 16) * 16;
    if (arena.alloc_offset + aligned) > arena.size {
        return 0 as *mut u8;
    }
    let ptr: *mut u8 = arena.v_write + arena.alloc_offset;
    arena.alloc_offset = arena.alloc_offset + aligned;
    return ptr;
}

fn dvam_exec_addr_of(arena: *DvamArena, write_ptr: *u8) -> *u8 {
    let diff: u64 = (write_ptr as u64) - (arena.v_write as u64);
    return arena.v_exec + diff;
}

fn dvam_advance_generation(arena: *mut DvamArena) {
    arena.generation = arena.generation + 1;
}

fn dvam_get_generation(arena: *DvamArena) -> u64 {
    return arena.generation;
}

// -------------------------------------------------------------------------
//           4. ARLL-Agent Epoch, Boot & Live Patcher
// -------------------------------------------------------------------------

fn arll_agent_advance_generation(arena: *mut DvamArena) -> u64 {
    arena.generation = arena.generation + 1;
    hasi_synchronize_icache_ex(arena.v_exec, arena.size, 1, 0 as *mut u8);
    return arena.generation;
}

fn arll_agent_get_generation(arena: *DvamArena) -> u64 {
    return arena.generation;
}

fn arll_patch_code_via_dvam(arena: *mut DvamArena, relocs: *mut EiaRelocHole, reloc_count: u64, tg: *mut EiaTypeGraphEntry, tg_count: u64) -> u64 {
    let mut patched: u64 = 0;
    let mut i: u64 = 0;
    while i < reloc_count {
        let hole: *mut EiaRelocHole = ((relocs as *mut u8) + (i * 24)) as *mut EiaRelocHole;
        let disp: i64 = eia_resolve_field_displacement(tg, tg_count, hole.type_sig_hash, hole.field_or_sym_hash);
        if disp >= 0 {
            let target_ptr: *mut u8 = arena.v_write + (hole.insn_offset as u64);
            let d: u32 = disp as u32;
            target_ptr[0] = (d & 255) as u8;
            target_ptr[1] = ((d >> 8) & 255) as u8;
            target_ptr[2] = ((d >> 16) & 255) as u8;
            target_ptr[3] = ((d >> 24) & 255) as u8;
            patched = patched + 1;
        }
        i = i + 1;
    }
    dvam_advance_generation(arena);
    return patched;
}

fn arll_boot_patch_holes(v_write: *mut u8, holo: *UniversalHologramHeader) -> u64 {
    // FAIL-CLOSED: Validate the complete image BEFORE any patching occurs.
    // If validation fails, return the error code as a u64 with bit 63 set
    // to distinguish from a valid patch count. No executable bytes are modified.
    // v_write is the image base; holo points to the header within the image.
    let contracts_offset: u64 = (*holo).contracts_offset;
    let contracts_count: u64 = (*holo).contracts_count;
    let relocs_offset: u64 = (*holo).relocs_offset;
    let relocs_count: u64 = (*holo).relocs_count;
    let type_graph_offset: u64 = (*holo).type_graph_offset;
    let type_graph_size: u64 = (*holo).type_graph_size;

    let mut needed_size: u64 = 96; // header
    // Overflow-safe accumulation
    let c_end: u64 = contracts_offset + (contracts_count * 48);
    let r_end: u64 = relocs_offset + (relocs_count * 24);
    let t_end: u64 = type_graph_offset + type_graph_size;
    if c_end > needed_size { needed_size = c_end; }
    if r_end > needed_size { needed_size = r_end; }
    if t_end > needed_size { needed_size = t_end; }

    let v_res: i64 = eia_validate_image(v_write, needed_size);
    if v_res != 0 {
        // Return error code with bit 63 set to distinguish from valid patch count
        return (v_res as i64 as u64) | (1 << 63);
    }

    let relocs: *mut EiaRelocHole = (v_write + (*holo).relocs_offset) as *mut EiaRelocHole;
    let tg: *mut EiaTypeGraphEntry = (v_write + (*holo).type_graph_offset) as *mut EiaTypeGraphEntry;
    let tg_cnt: u64 = (*holo).type_graph_size / 24;

    let mut patched: u64 = 0;
    let mut i: u64 = 0;
    while i < (*holo).relocs_count {
        let hole: *mut EiaRelocHole = ((relocs as *mut u8) + (i * 24)) as *mut EiaRelocHole;
        let disp: i64 = eia_resolve_field_displacement(tg, tg_cnt, (*hole).type_sig_hash, (*hole).field_or_sym_hash);
        if disp >= 0 {
            let target_ptr: *mut u8 = v_write + ((*hole).insn_offset as u64);
            let d: u32 = disp as u32;
            target_ptr[0] = (d & 255) as u8;
            target_ptr[1] = ((d >> 8) & 255) as u8;
            target_ptr[2] = ((d >> 16) & 255) as u8;
            target_ptr[3] = ((d >> 24) & 255) as u8;
            patched = patched + 1;
        }
        i = i + 1;
    }
    return patched;
}

// -------------------------------------------------------------------------
//           5. GDAM (Generation-Driven Schema Migration & Parametricity)
// -------------------------------------------------------------------------

fn gdam_stage_new_schema(gdam: *mut GdamState, new_tg: *mut EiaTypeGraphEntry, count: u64) -> u64 {
    gdam.staged_schema = new_tg;
    gdam.staged_count = count;
    return 0;
}

fn gdam_publish_entry_vector(gdam: *mut GdamState, new_entry: *u8) -> u64 {
    gdam.current_epoch = gdam.current_epoch + 1;
    gdam.entry_vector = new_entry;
    return gdam.current_epoch;
}

fn gdam_is_pointer_current(gdam: *GdamState, ptr_epoch: u64) -> u64 {
    if ptr_epoch == gdam.current_epoch {
        return 1;
    }
    return 0;
}

fn gdam_migrate_struct(old_buf: *u8, old_tg: *mut EiaTypeGraphEntry, new_buf: *mut u8, new_tg: *mut EiaTypeGraphEntry, count: u64, type_hash: u64) -> u64 {
    let mut migrated_fields: u64 = 0;
    let mut ni: u64 = 0;

    while ni < count {
        let n_entry: *mut EiaTypeGraphEntry = ((new_tg as *mut u8) + (ni * 24)) as *mut EiaTypeGraphEntry;
        if n_entry.type_sig_hash == type_hash {
            // Find field in old type graph
            let mut oi: u64 = 0;
            while oi < count {
                let o_entry: *mut EiaTypeGraphEntry = ((old_tg as *mut u8) + (oi * 24)) as *mut EiaTypeGraphEntry;
                if o_entry.type_sig_hash == type_hash && o_entry.field_hash == n_entry.field_hash {
                    let old_off: u64 = o_entry.byte_offset as u64;
                    let new_off: u64 = n_entry.byte_offset as u64;
                    let copy_sz: u64 = o_entry.field_size as u64;
                    let target_sz: u64 = n_entry.field_size as u64;

                    // Copy existing field bytes
                    let mut b: u64 = 0;
                    while b < copy_sz && b < target_sz {
                        new_buf[new_off + b] = old_buf[old_off + b];
                        b = b + 1;
                    }
                    // Auto-widen with zeros if target size > old size
                    while b < target_sz {
                        new_buf[new_off + b] = 0;
                        b = b + 1;
                    }

                    migrated_fields = migrated_fields + 1;
                    oi = count; // break
                }
                oi = oi + 1;
            }
        }
        ni = ni + 1;
    }

    return migrated_fields;
}

// -------------------------------------------------------------------------
//           6. HASI Multi-ISA I-Cache Barrier
// -------------------------------------------------------------------------

fn hasi_synchronize_icache_ex(addr: *u8, len: u64, target_isa: u64, stencil_out: *mut u8) -> u64 {
    // ISA 1 = x86-64
    if target_isa == 1 {
        if stencil_out != (0 as *mut u8) {
            stencil_out[0] = 15;  stencil_out[1] = 162; // cpuid (0F A2)
            stencil_out[2] = 15;  stencil_out[3] = 174; stencil_out[4] = 240; // mfence (0F AE F0)
        }
        return 5;
    }

    // ISA 2 = ARM64
    if target_isa == 2 {
        if stencil_out != (0 as *mut u8) {
            // 1. DC CVAU (0xD50B7B20)
            stencil_out[0] = 32;  stencil_out[1] = 123; stencil_out[2] = 11;  stencil_out[3] = 213;
            // 2. DSB ISH (0xD5033B9F)
            stencil_out[4] = 159; stencil_out[5] = 59;  stencil_out[6] = 3;   stencil_out[7] = 213;
            // 3. IC IALLU (0xD508751F)
            stencil_out[8] = 31;  stencil_out[9] = 117; stencil_out[10] = 8;  stencil_out[11] = 213;
            // 4. DSB ISH (0xD5033B9F)
            stencil_out[12] = 159; stencil_out[13] = 59; stencil_out[14] = 3;  stencil_out[15] = 213;
            // 5. ISB (0xD5033FDF)
            stencil_out[16] = 223; stencil_out[17] = 63; stencil_out[18] = 3;  stencil_out[19] = 213;
        }
        return 20;
    }

    // ISA 4 = RISC-V 64
    if target_isa == 4 {
        if stencil_out != (0 as *mut u8) {
            // 1. FENCE iorw, iorw (0x0FF0000F)
            stencil_out[0] = 15; stencil_out[1] = 0;  stencil_out[2] = 240; stencil_out[3] = 15;
            // 2. FENCE.I (0x0000100F)
            stencil_out[4] = 15; stencil_out[5] = 16; stencil_out[6] = 0;   stencil_out[7] = 0;
        }
        return 8;
    }

    return 0;
}

// -------------------------------------------------------------------------
//           7. Dynamic Layout Invariance Test (Reynolds' Parametricity)
// -------------------------------------------------------------------------

fn executor_execute_with_layout(arena: *mut DvamArena, stencil_write: *mut u8, tg: *mut EiaTypeGraphEntry, tg_count: u64, reloc: *mut EiaRelocHole, obj_buf: *u8) -> u64 {
    // 1. Reset stencil: lea rax, [rdi + 0x00000000]; mov rax, [rax]; ret
    stencil_write[0] = 72;  stencil_write[1] = 141; stencil_write[2] = 135;
    stencil_write[3] = 0;   stencil_write[4] = 0;   stencil_write[5] = 0;   stencil_write[6] = 0;
    stencil_write[7] = 72;  stencil_write[8] = 139; stencil_write[9] = 0;
    stencil_write[10] = 195;

    // 2. Patch displacement hole according to given layout
    arll_patch_code_via_dvam(arena, reloc, 1, tg, tg_count);

    // 3. Resolve execution address and run
    let fn_exec: *u8 = dvam_exec_addr_of(arena, stencil_write);
    let val: u64 = fn_exec(obj_buf);
    return val;
}

// -------------------------------------------------------------------------
//           8. Main End-to-End Verification Driver & Latency Benchmark
// -------------------------------------------------------------------------

fn main() -> i64 {
    // 1. Create a 65536-byte DvamArena
    let mut arena: DvamArena;
    let create_res: i64 = dvam_create(&mut arena, 65536);
    if create_res < 0 {
        let err1: *u8 = "ERROR: Failed to create DvamArena\n";
        syscall(1, 2, err1, 33);
        syscall(60, 1);
        return 1;
    }

    // Verify dvam_alloc, dvam_exec_addr_of, dvam_get_generation
    let alloc_p1: *mut u8 = dvam_alloc(&mut arena, 32);
    if alloc_p1 == (0 as *mut u8) {
        syscall(60, 2);
        return 2;
    }
    let exec_p1: *u8 = dvam_exec_addr_of(&arena, alloc_p1);
    let gen0: u64 = dvam_get_generation(&arena);
    if gen0 != 1 {
        syscall(60, 3);
        return 3;
    }

    // 2. Emit hardware rdtsc measurement stencil into DVAM
    //    rdtsc (0F 31); shl rdx, 32 (48 C1 E2 20); or rax, rdx (48 09 D0); ret (C3)
    let rdtsc_write: *mut u8 = dvam_alloc(&mut arena, 16);
    rdtsc_write[0] = 15;  rdtsc_write[1] = 49;
    rdtsc_write[2] = 72;  rdtsc_write[3] = 193; rdtsc_write[4] = 226; rdtsc_write[5] = 32;
    rdtsc_write[6] = 72;  rdtsc_write[7] = 9;   rdtsc_write[8] = 208;
    rdtsc_write[9] = 195;
    let rdtsc_fn: *u8 = dvam_exec_addr_of(&arena, rdtsc_write);

    // 3. Verify Real BLAKE3-64 Hashing
    let test_str: *u8 = "BLAKE3_EIA_SOVEREIGN_CONTRACT";
    let b3_hash: u64 = blake3_hash64(test_str, 29);
    if b3_hash == 0 {
        syscall(60, 4);
        return 4;
    }

    // 4. Verify GDAM State & Migration (Reynolds' Parametricity)
    let mut gdam: GdamState;
    gdam.current_epoch = 1;
    gdam.staged_count = 0;

    let p_tg_A: *mut EiaTypeGraphEntry = dvam_alloc(&mut arena, 48) as *mut EiaTypeGraphEntry;
    p_tg_A.type_sig_hash = 100;
    p_tg_A.field_hash = 501; // "id"
    p_tg_A.byte_offset = 0;
    p_tg_A.field_size = 8;
    let p_tg_A1: *mut EiaTypeGraphEntry = ((p_tg_A as *mut u8) + 24) as *mut EiaTypeGraphEntry;
    p_tg_A1.type_sig_hash = 100;
    p_tg_A1.field_hash = 502; // "balance"
    p_tg_A1.byte_offset = 8;  // layout A: balance at +8
    p_tg_A1.field_size = 8;

    let p_tg_B: *mut EiaTypeGraphEntry = dvam_alloc(&mut arena, 48) as *mut EiaTypeGraphEntry;
    p_tg_B.type_sig_hash = 100;
    p_tg_B.field_hash = 501; // "id"
    p_tg_B.byte_offset = 0;
    p_tg_B.field_size = 8;
    let p_tg_B1: *mut EiaTypeGraphEntry = ((p_tg_B as *mut u8) + 24) as *mut EiaTypeGraphEntry;
    p_tg_B1.type_sig_hash = 100;
    p_tg_B1.field_hash = 502; // "balance"
    p_tg_B1.byte_offset = 16; // layout B: balance at +16
    p_tg_B1.field_size = 8;

    gdam_stage_new_schema(&mut gdam, p_tg_B, 2);
    let new_epoch: u64 = gdam_publish_entry_vector(&mut gdam, arena.v_exec);
    if new_epoch != 2 || gdam_is_pointer_current(&gdam, 2) != 1 {
        syscall(60, 5);
        return 5;
    }

    // Migrate struct instance from Layout A to Layout B
    let mut obj_A_buf: [u8; 32];
    let obj_A: *mut u8 = &mut obj_A_buf[0];
    // Put id = 1001 at offset 0, balance = 42 at offset 8
    set_u32(obj_A, 0, 1001);
    set_u32(obj_A, 2, 42);

    let mut obj_B_buf: [u8; 32];
    let obj_B: *mut u8 = &mut obj_B_buf[0];
    let migrated: u64 = gdam_migrate_struct(obj_A, p_tg_A, obj_B, p_tg_B, 2, 100);
    if migrated != 2 || get_u32(obj_B, 4) != 42 {
        syscall(60, 6);
        return 6;
    }

    // 5. Verify HASI Multi-ISA Barrier Code Emission
    let mut barrier_buf: [u8; 32];
    let b_ptr: *mut u8 = &mut barrier_buf[0];
    let x86_sz: u64 = hasi_synchronize_icache_ex(0 as *u8, 0, 1, b_ptr);
    if x86_sz != 5 || b_ptr[0] != 15 || b_ptr[1] != 162 {
        syscall(60, 7);
        return 7;
    }
    let arm_sz: u64 = hasi_synchronize_icache_ex(0 as *u8, 0, 2, b_ptr);
    if arm_sz != 20 || b_ptr[0] != 32 {
        syscall(60, 8);
        return 8;
    }
    let riscv_sz: u64 = hasi_synchronize_icache_ex(0 as *u8, 0, 4, b_ptr);
    if riscv_sz != 8 || b_ptr[0] != 15 {
        syscall(60, 9);
        return 9;
    }

    // 6. Verify Dynamic Layout Invariance: Eval(P[R_A]) == Eval(P[R_B]) == 42
    let stencil_write: *mut u8 = dvam_alloc(&mut arena, 32);
    let hole_disp: u64 = ((stencil_write as u64) - (arena.v_write as u64)) + 3;
    let mut reloc: EiaRelocHole;
    reloc.insn_offset = hole_disp as u32;
    reloc.patch_kind = 1;
    reloc.type_sig_hash = 100;
    reloc.field_or_sym_hash = 502; // "balance"

    // Zero-fill obj_A and obj_B
    let mut zi: u64 = 0;
    while zi < 32 {
        obj_A[zi] = 0;
        obj_B[zi] = 0;
        zi = zi + 1;
    }
    // Layout A: balance is at byte offset 8
    set_u32(obj_A, 0, 1001); // id
    set_u32(obj_A, 2, 42);   // balance
    // Layout B: balance is at byte offset 16
    set_u32(obj_B, 0, 1001); // id
    set_u32(obj_B, 4, 42);   // balance

    let res_A: u64 = executor_execute_with_layout(&mut arena, stencil_write, p_tg_A, 2, &mut reloc, obj_A);
    let res_B: u64 = executor_execute_with_layout(&mut arena, stencil_write, p_tg_B, 2, &mut reloc, obj_B);
    if res_A != 42 || res_B != 42 {
        syscall(60, 10);
        return 10;
    }

    // 7. Hardware Latency Benchmark using rdtsc & clock_gettime
    let mut ts_start: Timespec;
    let mut ts_end: Timespec;
    syscall(228, 1, &mut ts_start); // CLOCK_MONOTONIC
    let cyc_start: u64 = rdtsc_fn();

    // Perform canonical boot-patching
    let patched_count: u64 = arll_patch_code_via_dvam(&mut arena, &mut reloc, 1, p_tg_B, 2);

    let cyc_end: u64 = rdtsc_fn();
    syscall(228, 1, &mut ts_end);

    let elapsed_cycles: u64 = cyc_end - cyc_start;
    let elapsed_ns: i64 = ((ts_end.sec - ts_start.sec) * 1000000000) + (ts_end.nsec - ts_start.nsec);

    // Assert latency < 12 microseconds (12,000 ns)
    if elapsed_ns >= 12000 {
        syscall(60, 11);
        return 11;
    }

    // Print Latency Benchmark Confirmation
    let bench_msg: *u8 = "[BENCH] Hardware Boot-Patch Latency: <12 us PASS (verified)\n";
    syscall(1, 1, bench_msg, 60);

    // 8. Output Success Message: "STAGE1 EIA DVAM RUNTIME OK\n" (27 bytes)
    let msg: *u8 = "STAGE1 EIA DVAM RUNTIME OK\n";
    syscall(1, 1, msg, 27);

    // 9. Return 16 to preserve exact test harness contract
    syscall(60, 16);
    return 16;
}
