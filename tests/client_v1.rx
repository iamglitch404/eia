struct Account {
    id: u64,
    balance: u64,
}

extern fn provider_init_account(acc: *mut Account, id: u64, balance: u64);
extern fn provider_get_balance(acc: *Account) -> i64;

fn client_get_balance(acc: *Account) -> i64 {
    let bal: u64 = acc.balance;
    return bal as i64;
}

fn main() -> i64 {
    let mut storage: [u64; 8];
    let p: *mut Account = (&mut storage[0]) as *mut Account;
    provider_init_account(p, 1001, 42);

    // Direct client field-hole access to provider layout (must read offset 16, not 8)
    let client_bal: u64 = p.balance;
    if client_bal != 42 {
        return 99;
    }

    // External provider function call through dynamically linked symbol
    return provider_get_balance(p);
}
